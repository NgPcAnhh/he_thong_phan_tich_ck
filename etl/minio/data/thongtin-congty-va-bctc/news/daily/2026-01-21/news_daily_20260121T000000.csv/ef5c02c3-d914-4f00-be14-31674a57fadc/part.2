	<tbody>
		<tr>
			<td class=""pic""><img alt=""Cổ đông lớn giảm sở hữu tại BaF Việt Nam sau đợt tăng vốn."" data-height=""324"" data-image-id=""523022"" data-original="""" data-photo-original-src="""" data-src="""" data-width=""1526"" height="""" sizes="""" src=""https://cdn.fiingroup.vn/medialib/127379/I/2025/10/30/screenshot20251030at14583567456352_17285303852950700.png"" srcset="""" title=""Cổ đông lớn giảm sở hữu tại BaF Việt Nam sau đợt tăng vốn."" width="""" /></td>
