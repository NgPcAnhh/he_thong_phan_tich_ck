69770_VI_GiaiTrinhLienQuanDenBCTC_2024.pdf" title="Tải về" download>000000015169770_VI_GiaiTrinhLienQuanDenBCTC_2024.pdf</a></td></tr><tr><td>\xa0</td><td><a href="https://cmsv5.fiingroup.vn/medialib/FG/2025/2025-07/2025-07-22/TMC/000000015188914_VI_CBTT.pdf" title="Tải về" download>000000015188914_VI_CBTT.pdf</a></td></tr><tr><td>\xa0</td><td><a href="https://cmsv5.fiingroup.vn/medialib/FG/2025/2025-07/2025-07-22/TMC/000000015169762_VI_BaoCaoTaiChinh_Q2_2025.pdf" title="Tải về" download>000000015169762_VI_BaoCaoTaiChinh_Q2_2025.pdf</a></td></tr></table>', 'price_change_pct': 0.02564103, 'related_ticker': 'TMC', 'fetched_at': '2026-01-04 03:20:40'}, {'id': '7894022', 'author': None, 'friendly_sub_title': '', 'news_source_link': 'https://hnx.vn/vi-vn/m-tin-tuc-hnx/tintuc-569485-1.html', 'created_at': None, 'public_date': 1751907240000, 'updated_at': None, 'lang_code': 'vi', 'news_id': '11624071', 'news_short_content': 'Công bố thông tin đơn vị thực hiện soát xét và kiếm toán BCTC năm 2025', 'news_full_content': '.<table width="100%" style=\'text-align: left;border=0\'><tr><td colspan=\'2\'><hr /></td></tr><tr><td colspan=\'2\'>Tài liệu đính kèm</td></tr><tr><td>\xa0</td><td><a href="https://cmsv5.fiingroup.vn/medialib/FG/2025/2025-07/2025-07-07/TMC/000000015127387_DK_CBTT_HopDongKiemToan.pdf" title="Tải về" download>000000015127387_DK_CBTT_HopDongKiemToan.pdf</a></td></tr></table>', 'price_change_pct': 0.0, 'related_ticker': 'TMC', 'fetched_at': '2026-01-04 03:20:40'}, {'id': '7508140', 'author': None, 'friendly_sub_title': '', 'news_source_link': 'https://hnx.vn/vi-vn/m-tin-tuc-hnx/tintuc-563222-1.html', 'created_at': None, 'public_date': 1747239600000, 'updated_at': None, 'lang_code': 'vi', 'news_id': '11572401', 'news_short_content': 'Ngày đăng ký cuối cùng trả cổ tức bằng tiền mặt', 'news_full_content': 'Thông báo ngày đăng ký cuối cùng lập danh sách cổ đông đối với cổ phiếu TMC của CTCP Thương mại Xuất nhập khẩu Thủ Đức như sau:<br>1. Ngày đăng ký cuối cùng: 21/05/2025<br>2. Ngày giao dịch không hưởng quyền: 20/05/2025<br>3. Lý do và mục đích: <br>\xa0\xa0\xa0\xa0\xa0* Trả cổ tức bằng tiền:  <br>\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0- Hình thức trả: Trả cổ tức bằng tiền năm 2024<br>\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0- Tỷ lệ thực hiện: 5%/cổ phiếu (01 cổ phiếu được nhận 500 đồng)<br>\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0- Thời gian thực hiện: 30/05/2025<br>\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0- Địa điểm thực hiện: <br>\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0+ Chứng khoán chưa lưu ký: Người sở hữu làm thủ tục nhận cổ tức công ty tại văn phòng Công ty Cổ phần Thương Mại Xuất Nhập Khẩu Thủ Đức (Địa chỉ: 231 Võ Văn Ngân, Phường Linh Chiểu, Thành phố Thủ Đức, TP. HCM) vào các ngày làm việc trong tuần bắt đầu từ ngày 30/05/2025 và xuất trình Căn cước công dân/Căn cước.<br>\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0+ Chứng khoán lưu ký: Người sở hữu làm thủ tục nhận cổ tức tại các Thành viên lưu ký nơi mở tài khoản lưu ký.', 'price_change_pct': 0.0, 'related_ticker': 'TMC', 'fetched_at': '2026-01-04 03:20:40'}, {'id': '9067033', 'author': None, 'friendly_sub_title': '', 'news_source_link': 'https://hnx.vn/vi-vn/m-tin-tuc-hnx/tintuc-591755-1.html', 'created_at': None, 'public_date': 1767103440000, 'updated_at': None, 'lang_code': 'vi', 'news_id': '11831473', 'news_short_content': 'Quyết định HĐQT', 'news_full_content': '.<table width="100%" style=\'text-align: left;border=0\'><tr><td colspan=\'2\'><hr /></td></tr><tr><td colspan=\'2\'>Tài liệu đính kèm</td></tr><tr><td>\xa0</td><td><a href="https://cmsv5.fiingroup.vn/medialib/FG/2025/2025-12/2025-12-30/TMB/000000015673836_CV_2947._Cong_bo_thong_tin.pdf" title="Tải về" download>000000015673836_CV_2947._Cong_bo_thong_tin.pdf</a></td></tr></table>', 'price_change_pct': -0.01433692, 'related_ticker': 'TMB', 'fetched_at': '2026-01-04 03:20:42'}, {'id': '8905533', 'author': None, 'friendly_sub_title': '', 'news_source_link': 'https://hnx.v