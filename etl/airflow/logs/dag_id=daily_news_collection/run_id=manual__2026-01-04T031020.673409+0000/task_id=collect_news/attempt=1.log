y_2.2025.pdf" title="Tải về" download>000000015222875_KS.CVGT_BCTC_Tong_hop_Quy_2.2025.pdf</a></td></tr></table>', 'price_change_pct': -0.04040404, 'related_ticker': 'C69', 'fetched_at': '2026-01-04 04:05:52'}, {'id': '8872705', 'author': None, 'friendly_sub_title': '', 'news_source_link': 'https://www.tinnhanhchungkhoan.vn/cienco-4-c4g-tam-dung-ke-hoach-phat-hanh-1787-trieu-co-phieu-de-tra-co-tuc-nam-2024-post380986.html', 'created_at': None, 'public_date': 1764020940000, 'updated_at': None, 'lang_code': 'vi', 'news_id': '11801986', 'news_short_content': 'CTCP Tập đoàn Cienco 4 (mã C4G - UPCoM) sẽ không thực hiện trả cổ tức năm 2024 bằng cổ phiếu khi mà giá cổ phiếu trên sàn đang giao dịch dưới mệnh giá 10.000 đồng/cổ phiếu.', 'news_full_content': '<div class="banner clearfix" data-platform="1" data-position="Web_AdsArticleAfterAvatar" id="adsWeb_AdsArticleAfterAvatar">Cienco 4 thông qua việc tạm dừng triển khai thực hiện phương án phát hành cổ phiếu để trả cổ tức năm 2024 do hiện tại giá cổ phiếu đang giao dịch thấp hơn mệnh giá.</div>\r\n\r\n<p>Trong đó, toàn bộ lợi nhuận chưa thực hiện cho việc phát hành cổ phiếu để chi trả cổ tức của kỳ này sẽ được Cienco 4 cộng dồn vào lợi nhuận của kỳ báo cáo năm 2025, đồng thời Cienco 4 sẽ thực hiện phương án chi trả cổ tức bằng tiền (khi Nhà nước mua lại dự án đầu tư BOT Thái Nguyên Chợ Mới) hoặc phương án phát hành thêm cổ phiếu để trả cổ tức sau khi được chấp thuận của Uỷ ban Chứng khoán Nhà nước.</p>\r\n\r\n<div class="ads_middle">\r\n<div class="banner fyi" data-position="Web_AdsArticleMiddle" id="adsWeb_AdsArticleMiddle">Trước đó, trong Đại hội đồng cổ đông năm 2025, Cienco 4 đã thông qua kế hoạch trả cổ tức năm 2024 với tỷ lệ 5%, tương ứng phát hành tối đa 17,87 triệu cổ phiếu và dự kiến thực hiện trong quý II hoặc quý III/2025.</div>\r\n</div>\r\n\r\n<p>Về hoạt động kinh doanh, trong 9 tháng đầu năm 2025, Cienco 4 ghi nhận doanh thu đạt 2.178,62 tỷ đồng, giảm 1,7% so với cùng kỳ, lợi nhuận sau thuế đạt 66,91 tỷ đồng, giảm 56,8% so với cùng kỳ năm trước. Trong đó, biên lợi nhuận gộp giảm mạnh từ 13,9%, về 11,9%.</p>\r\n\r\n<p>Trong năm 2025, Cienco 4 đặt kế hoạch doanh thu 4.000 tỷ đồng, lợi nhuận sau thuế tối thiểu 200 tỷ đồng và cổ tức dự kiến 7%.</p>', 'price_change_pct': nan, 'related_ticker': 'C4G', 'fetched_at': '2026-01-04 04:05:54'}, {'id': '8867775', 'author': None, 'friendly_sub_title': '', 'news_source_link': 'https://hnx.vn/vi-vn/m-tin-tuc-hnx/tintuc-588392-1.html', 'created_at': None, 'public_date': 1763996760000, 'updated_at': None, 'lang_code': 'vi', 'news_id': '11801728', 'news_short_content': 'Nghị quyết Hội đồng quản trị', 'news_full_content': '.<table width="100%" style=\'text-align: left;border=0\'><tr><td colspan=\'2\'><hr /></td></tr><tr><td colspan=\'2\'>Tài liệu đính kèm</td></tr><tr><td>\xa0</td><td><a href="https://cmsv5.fiingroup.vn/medialib/FG/2025/2025-11/2025-11-24/C4G/000000015605740_13266._CBTT_tam_dung_tra_co_tuc_bang_CP.ks.pdf" title="Tải về" download>000000015605740_13266._CBTT_tam_dung_tra_co_tuc_bang_CP.ks.pdf</a></td></tr><tr><td>\xa0</td><td><a href="https://cmsv5.fiingroup.vn/medialib/FG/2025/2025-11/2025-11-24/C4G/000000015605994_QD22037._Tam_dung_phat_hanh_CP_tra_co_tuc_nam_2024.ks.pdf" title="Tải về" download>000000015605994_QD22037._Tam_dung_phat_hanh_CP_tra_co_tuc_nam_2024.ks.pdf</a></td></tr></table>', 'price_change_pct': -0.00333333, 'related_ticker': 'C4G', 'fetched_at': '2026-01-04 04:05:54'}, {'id': '8713509', 'author': None, 'friendly_sub_title': '', 'news_source_link': 'https://hnx.vn/vi-vn/m-tin-tuc-hnx/tintuc-585341-1.html', 'created_at': None, 'public_date': 1761746580000, 'updated_at': None, 'lang_code': 'vi', 'news_id': '11777191', 'news_short_content': 'Báo cáo tài chính quý 3/2025 (công ty mẹ)', 'news_full_content': ' <table width="100%" style=\'text-align: left;border=0\'><tr><td colspan=\'2\'><hr /></td></tr><tr><td colspan=\'2\'>Tài liệu đính kèm</td></tr><tr><td>\xa0</td><td><a href="https://cmsv5.fiingroup.vn/medial