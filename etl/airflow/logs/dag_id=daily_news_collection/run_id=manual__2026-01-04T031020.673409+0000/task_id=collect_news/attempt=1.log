x.vn/vi-vn/m-tin-tuc-hnx/tintuc-564350-1.html', 'created_at': None, 'public_date': 1748254560000, 'updated_at': None, 'lang_code': 'vi', 'news_id': '11589143', 'news_short_content': 'Ký hợp đồng kiểm toán báo cáo tài chính năm 2025', 'news_full_content': '.<table width="100%" style=\'text-align: left;border=0\'><tr><td colspan=\'2\'><hr /></td></tr><tr><td colspan=\'2\'>Tài liệu đính kèm</td></tr><tr><td>\xa0</td><td><a href="https://cmsv5.fiingroup.vn/medialib/FG/2025/2025-05/2025-05-26/VGL/000000014998662_cbtt_ky_hop_dong_kiem_toan_2025.pdf" title="Tải về" download>000000014998662_cbtt_ky_hop_dong_kiem_toan_2025.pdf</a></td></tr></table>', 'price_change_pct': 0.0, 'related_ticker': 'VGL', 'fetched_at': '2026-01-04 03:15:19'}, {'id': '7444996', 'author': None, 'friendly_sub_title': '', 'news_source_link': 'https://hnx.vn/vi-vn/m-tin-tuc-hnx/tintuc-561770-1.html', 'created_at': None, 'public_date': 1746518820000, 'updated_at': None, 'lang_code': 'vi', 'news_id': '11561867', 'news_short_content': 'Ngày đăng ký cuối cùng trả cổ tức bằng tiền mặt', 'news_full_content': 'Thông báo ngày đăng ký cuối cùng lập danh sách cổ đông đối với cổ phiếu VGL của CTCP Mạ kẽm công nghiệp Vingal-Vnsteel như sau:<br>1. Ngày đăng ký cuối cùng: 03/06/2025<br>2. Ngày giao dịch không hưởng quyền: 02/06/2025<br>3. Lý do và mục đích: <br>\xa0\xa0\xa0\xa0\xa0* Trả cổ tức bằng tiền:  <br>\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0- Hình thức trả: Trả cổ tức bằng tiền năm 2024<br>\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0- Tỷ lệ thực hiện: 16%/cổ phiếu (01 cổ phiếu được nhận 1.600 đồng)<br>\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0- Thời gian thực hiện: 27/06/2025<br>\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0- Địa điểm thực hiện: <br>\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0+ Chứng khoán chưa lưu ký: Người sở hữu chứng khoán làm thủ tục nhận cổ tức tại CTCP Mạ kẽm công nghiệp Vingal-Vnsteel (vào các ngày làm việc trong tuần) bắt đầu từ ngày 27/06/2025 và xuất trình căn cước công dân hoặc giấy đăng ký doanh nghiệp<br>\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0+ Chứng khoán lưu ký: Người sở hữu chứng khoán làm thủ tục nhận cổ tức tại các Thành viên lưu ký nơi mở tài khoản lưu ký', 'price_change_pct': 0.0, 'related_ticker': 'VGL', 'fetched_at': '2026-01-04 03:15:19'}, {'id': '7354100', 'author': None, 'friendly_sub_title': '', 'news_source_link': 'https://hnx.vn/vi-vn/m-tin-tuc-hnx/tintuc-560183-1.html', 'created_at': None, 'public_date': 1745671980000, 'updated_at': None, 'lang_code': 'vi', 'news_id': '11555956', 'news_short_content': 'Thông báo ngày đăng ký cuối cùng dự kiến để thực hiện quyền nhận cổ tức năm 2024', 'news_full_content': '.<table width="100%" style=\'text-align: left;border=0\'><tr><td colspan=\'2\'><hr /></td></tr><tr><td colspan=\'2\'>Tài liệu đính kèm</td></tr><tr><td>\xa0</td><td><a href="https://cmsv5.fiingroup.vn/medialib/FG/2025/2025-04/2025-04-26/024323_000000014864548_Mau_07thq__tra_co_tuc_2024.pdf" title="Tải về" download>024323_000000014864548_Mau_07thq__tra_co_tuc_2024.pdf</a></td></tr></table>', 'price_change_pct': nan, 'related_ticker': 'VGL', 'fetched_at': '2026-01-04 03:15:19'}, {'id': '7226687', 'author': None, 'friendly_sub_title': '', 'news_source_link': 'https://hnx.vn/vi-vn/m-tin-tuc-hnx/tintuc-557393-1.html', 'created_at': None, 'public_date': 1744813200000, 'updated_at': None, 'lang_code': 'vi', 'news_id': '11543224', 'news_short_content': 'VGL: Thông báo thay đổi người có liên quan của ông Võ Trí Nghĩa - Chủ tịch HĐQT', 'news_full_content': '<p>.</p>\r\n\r\n<table style="text-align: left;border=0" width="100%">\r\n\t<tbody>\r\n\t\t<tr>\r\n\t\t\t<td colspan="2">\r\n\t\t\t<hr /></td>\r\n\t\t</tr>\r\n\t\t<tr>\r\n\t\t\t<td colspan="2">Tài liệu đính kèm</td>\r\n\t\t</tr>\r\n\t\t<tr>\r\n\t\t\t<td>\xa0</td>\r\n\t\t\t<td><a download="" href="https://cmsv5.fiingroup.vn/medialib/FG/2025/2025-04/2025-04-16/144309_000000014786268_TB_THAY_DOI_NGUOI_CO_LIEN_QUAN__VO_TRI_NGHIA.pdf" title="Tải về">144309_00