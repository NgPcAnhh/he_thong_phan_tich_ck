-04 04:05:06'}, {'id': '7314669', 'author': None, 'friendly_sub_title': '', 'news_source_link': 'https://hnx.vn/vi-vn/m-tin-tuc-hnx/tintuc-559589-1.html', 'created_at': None, 'public_date': 1745504160000, 'updated_at': None, 'lang_code': 'vi', 'news_id': '11553402', 'news_short_content': 'Nghị quyết Đại hội đồng cổ đông thường niên năm 2025', 'news_full_content': '<table width="100%" style=\'text-align: left;border=0\'><tr><td colspan=\'2\'><hr /></td></tr><tr><td colspan=\'2\'>Tài liệu đính kèm</td></tr><tr><td>\xa0</td><td><a href="https://cmsv5.fiingroup.vn/medialib/FG/2025/2025-04/2025-04-24/141839_000000014844224_20250423_CBTT_10__VCC_Ve_viec_Nghi_quyet_Dai_hoi_dong_co_dong_thuong_nien_nam_2025_nen.pdf" title="Tải về" download>141839_000000014844224_20250423_CBTT_10__VCC_Ve_viec_Nghi_quyet_Dai_hoi_dong_co_dong_thuong_nien_nam_2025_nen.pdf</a></td></tr></table>', 'price_change_pct': 0.0, 'related_ticker': 'CCV', 'fetched_at': '2026-01-04 04:05:06'}, {'id': '7301030', 'author': None, 'friendly_sub_title': '', 'news_source_link': 'https://hnx.vn/vi-vn/m-tin-tuc-hnx/tintuc-559239-1.html', 'created_at': None, 'public_date': 1745418060000, 'updated_at': None, 'lang_code': 'vi', 'news_id': '11551952', 'news_short_content': 'Tài liệu họp Đại hội đồng cổ đông', 'news_full_content': '<table width="100%" style=\'text-align: left;border=0\'><tr><td colspan=\'2\'><hr /></td></tr><tr><td colspan=\'2\'>Tài liệu đính kèm</td></tr><tr><td>\xa0</td><td><a href="https://cmsv5.fiingroup.vn/medialib/FG/2025/2025-04/2025-04-23/144055_000000014841927_20250418_CBTT_08VCC_Ve_vien_dieu_chinh_noi_dung_tai_lieu_dai_hoi_dong_co_dong_thuong_nien_nam_2025.pdf" title="Tải về" download>144055_000000014841927_20250418_CBTT_08VCC_Ve_vien_dieu_chinh_noi_dung_tai_lieu_dai_hoi_dong_co_dong_thuong_nien_nam_2025.pdf</a></td></tr></table>', 'price_change_pct': 0.0, 'related_ticker': 'CCV', 'fetched_at': '2026-01-04 04:05:06'}, {'id': '7287987', 'author': None, 'friendly_sub_title': '', 'news_source_li