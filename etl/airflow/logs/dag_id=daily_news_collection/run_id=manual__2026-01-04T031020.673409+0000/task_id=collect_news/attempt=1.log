3500_20.Bao_cao_ket_qua_BTK.pdf" title="Tải về" download>000000015643500_20.Bao_cao_ket_qua_BTK.pdf</a></td></tr></table>', 'price_change_pct': 0.0, 'related_ticker': 'AMC', 'fetched_at': '2026-01-04 04:11:15'}, {'id': '8852144', 'author': None, 'friendly_sub_title': '', 'news_source_link': 'https://hnx.vn/vi-vn/m-tin-tuc-hnx/tintuc-588181-1.html', 'created_at': None, 'public_date': 1763719920000, 'updated_at': None, 'lang_code': 'vi', 'news_id': '11799633', 'news_short_content': 'Ngày đăng ký cuối cùng trả cổ phiếu thưởng cho cổ đông hiện hữu', 'news_full_content': '<p>Thông báo ngày đăng ký cuối cùng lập danh sách cổ đông đối với cổ phiếu AMC của Công ty cổ phần Khoáng sản Á Châu như sau:<br />\r\n1. Ngày đăng ký cuối cùng: 02/12/2025<br />\r\n2. Ngày giao dịch không hưởng quyền: 01/12/2025<br />\r\n3. Lý do và mục đích:<br />\r\n\xa0\xa0\xa0\xa0\xa0* Trả cổ phiếu thưởng cho cổ đông hiện hữu:<br />\r\n\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0- Tỷ lệ thực hiện: 2:1 (Người sở hữu 2 cổ phiếu được nhận 1 cổ phiếu mới)<br />\r\n\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0- Phương án làm tròn, phương án xử lý cổ phiếu lẻ: Số cổ phiếu thưởng mỗi cổ đông được nhận sẽ được làm tròn xuống hàng đơn vị. Số cổ phiếu lẻ hàng thập phân (nếu có) sẽ bị hủy bỏ.<br />\r\nVí dụ: Tại ngày đăng ký cuối cùng nhận cổ phiếu thưởng, Cổ đông Nguyễn Văn A sở hữu 11 cổ phiếu. Số cổ phiếu thưởng ông Nguyễn Văn A nhận được tính theo tỷ lệ phát hành là (11 x 1)/ 2 = 5,5. Sau khi làm tròn, số cổ phiếu thưởng ông Nguyễn Văn A nhận được là 5 cổ phiếu và 0,5 cổ phiếu lẻ sẽ bị hủy bỏ.<br />\r\n\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0- Địa điểm thực hiện:<br />\r\n\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0+ Chứng khoán chưa lưu ký: Người sở hữu làm thủ tục nhận cổ phiếu phát hành để tăng vốn cổ phần từ nguồn vốn chủ sở hữu tại Trụ sở chính của Công ty cổ phần Khoáng Sản Á Châu (Lô 32-Khu C – Khu Công nghiệp Nam Cấm, xã Trung Lộc, tỉnh Nghệ An, Việt Nam) và xuất trình căn cước công dân/căn cước.<br />\r\n\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0+ Chứng khoán lưu ký: Người sở hữu làm thủ tục nhận cổ phiếu phát hành để tăng vốn cổ phần từ nguồn vốn chủ sở hữu tại các Thành viên lưu ký (TVLK) nơi mở tài khoản lưu ký.</p>', 'price_change_pct': 0.0, 'related_ticker': 'AMC', 'fetched_at': '2026-01-04 04:11:15'}, {'id': '8840414', 'author': None, 'friendly_sub_title': '', 'news_source_link': 'https://hnx.vn/vi-vn/m-tin-tuc-hnx/tintuc-587889-1.html', 'created_at': None, 'public_date': 1763545860000, 'updated_at': None, 'lang_code': 'vi', 'news_id': '11796894', 'news_short_content': 'Công bố thông tin thông báo phát hành cổ phiếu để tăng vốn cổ phần', 'news_full_content': '.<table width="100%" style=\'text-align: left;border=0\'><tr><td colspan=\'2\'><hr /></td></tr><tr><td colspan=\'2\'>Tài liệu đính kèm</td></tr><tr><td>\xa0</td><td><a href="https://cmsv5.fiingroup.vn/medialib/FG/2025/2025-11/2025-11-19/AMC/000000015597380_19.CBTTPHCP_AMC.pdf" title="Tải về" download>000000015597380_19.CBTTPHCP_AMC.pdf</a></td></tr></table>', 'price_change_pct': 0.0, 'related_ticker': 'AMC', 'fetched_at': '2026-01-04 04:11:15'}, {'id': '8851522', 'author': None, 'friendly_sub_title': '', 'news_source_link': 'https://hnx.vn/vi-vn/m-tin-tuc-hnx/tintuc-587736-1.html', 'created_at': None, 'public_date': 1763457900000, 'updated_at': None, 'lang_code': 'vi', 'news_id': '11795653', 'news_short_content': 'Công bố thông tin ngày đăng ký cuối cùng hưởng quyền nhận cổ phiểu phát hành do tăng vốn điều lệ', 'news_full_content': '<p>.</p>\r\n\r\n<table style="text-align: left;border=0" width="100%">\r\n\t<tbody>\r\n\t\t<tr>\r\n\t\t\t<td colspan="2">\r\n\t\t\t<hr /></td>\r\n\t\t</tr>\r\n\t\t<tr>\r\n\t\t\t<td colspan="2">Tài liệu đính kèm</td>\r\n\t\t</tr>\r\n\t\t<tr>\r\n\t\t\t<td>\xa0</td>\r\n\t\t\t<td><a download="" href="https://cmsv5.fiingroup.vn/medialib/FG/2025/2025-11/2025-11-18/AMC/000000015591263_19._Ngay_dang_ky_cuoi_cung_tang_von.pdf" title="Tải về">0000000155