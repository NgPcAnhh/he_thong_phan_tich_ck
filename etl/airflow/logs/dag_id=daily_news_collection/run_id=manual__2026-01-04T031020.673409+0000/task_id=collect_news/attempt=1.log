2025-09/2025-09-22/MSR/000000015430937_CBTT__thay_doi_so_luong_co_phan.pdf" title="Tải về" download>000000015430937_CBTT__thay_doi_so_luong_co_phan.pdf</a></td></tr></table>', 'price_change_pct': -0.01557078, 'related_ticker': 'MSR', 'fetched_at': '2026-01-04 03:40:14'}, {'id': '8492679', 'author': None, 'friendly_sub_title': '', 'news_source_link': 'https://hnx.vn/vi-vn/m-tin-tuc-hnx/tintuc-580974-1.html', 'created_at': None, 'public_date': 1758554340000, 'updated_at': None, 'lang_code': 'vi', 'news_id': '11717834', 'news_short_content': 'Báo cáo kết quả phát hành cổ phiếu ESOP năm 2025', 'news_full_content': '.<table width="100%" style=\'text-align: left;border=0\'><tr><td colspan=\'2\'><hr /></td></tr><tr><td colspan=\'2\'>Tài liệu đính kèm</td></tr><tr><td>\xa0</td><td><a href="https://cmsv5.fiingroup.vn/medialib/FG/2025/2025-09/2025-09-22/MSR/000000015430517_CBTT_Bao_cao_ket_qua_phat_hanh.pdf" title="Tải về" download>000000015430517_CBTT_Bao_cao_ket_qua_phat_hanh.pdf</a></td></tr></table>', 'price_change_pct': -0.01557078, 'related_ticker': 'MSR', 'fetched_at': '2026-01-04 03:40:14'}, {'id': '8417279', 'author': None, 'friendly_sub_title': '', 'news_source_link': 'https://hnx.vn/vi-vn/m-tin-tuc-hnx/tintuc-579872-1.html', 'created_at': None, 'public_date': 1757501880000, 'updated_at': None, 'lang_code': 'vi', 'news_id': '11706938', 'news_short_content': 'Thông báo phát hành cổ phiếu ESOP 2025', 'news_full_content': '.<table width="100%" style=\'text-align: left;border=0\'><tr><td colspan=\'2\'><hr /></td></tr><tr><td colspan=\'2\'>Tài liệu đính kèm</td></tr><tr><td>\xa0</td><td><a href="https://cmsv5.fiingroup.vn/medialib/FG/2025/2025-09/2025-09-10/MSR/000000015402063_MHT_CBTT_phat_hanh_ESOP_kem_TB_cua_SSC.pdf" title="Tải về" download>000000015402063_MHT_CBTT_phat_hanh_ESOP_kem_TB_cua_SSC.pdf</a></td></tr></table>', 'price_change_pct': 0.00306977, 'related_ticker': 'MSR', 'fetched_at': '2026-01-04 03:40:14'}, {'id': '8846253', 'author': None, 'friendly_sub_title': '', 'news_source_link': 'https://www.hsx.vn/vi/tin-tuc/msn-thong-bao-ky-hop-dong-kiem-toan-bctc-2025/2419073', 'created_at': None, 'public_date': 1763652067000, 'updated_at': None, 'lang_code': 'vi', 'news_id': '11798845', 'news_short_content': 'Công ty Cổ phần Tập đoàn MaSan thông báo ký hợp đồng kiểm toán BCTC 2025 như sau:', 'news_full_content': '<p>Công ty Cổ phần Tập đoàn MaSan thông báo ký hợp đồng kiểm toán BCTC 2025 như sau:</p><table width="100%" style=\'text-align: left;border=0\'><tr><td colspan=\'2\'><hr /></td></tr><tr><td colspan=\'2\'>Tài liệu đính kèm</td></tr><tr><td>\xa0</td><td><a href="https://cmsv5.fiingroup.vn/medialib/FG/2025/2025-11/2025-11-20/MSN/20251120--MSN--Cong-ty-ky-hop-dong-kiem-toan-bao-cao-tai-chinh-nam-2025--signed.pdf" title="Tải về" download>20251120--MSN--Cong-ty-ky-hop-dong-kiem-toan-bao-cao-tai-chinh-nam-2025--signed.pdf</a></td></tr></table>', 'price_change_pct': -0.00380711, 'related_ticker': 'MSN', 'fetched_at': '2026-01-04 03:40:16'}, {'id': '8721527', 'author': None, 'friendly_sub_title': '', 'news_source_link': 'https://www.tinnhanhchungkhoan.vn/masan-uu-tien-niem-yet-masan-consumer-va-masan-high-tech-materials-mo-ra-cac-co-hoi-hop-tac-cho-nha-dau-tu-chien-luoc-post379534.html', 'created_at': None, 'public_date': 1761816360000, 'updated_at': None, 'lang_code': 'vi', 'news_id': '11778206', 'news_short_content': 'Đó là chia sẻ của Lãnh đạo Tập đoàn Masan (mã MSN – sàn HOSE) tại Hội nghị nhà đầu tư quý III/2025 tổ chức chiều ngày 29/10/2025.', 'news_full_content': '<p>Ông Danny Le, Tổng giám đốc Masan chia sẻ, trong bối cảnh chung, sức mua tiêu dùng đang quay lại từ quý I tới quý III, và xu hướng này được kỳ vọng sẽ tiếp tục, đặc biệt xu hướng dịch chuyển từ chợ truyền thống sang kênh hiện đại đang diễn ra cực kỳ mạnh.</p>\r\n\r\n<p>Quan trọng hơn, ông Danny Le nhấn mạnh sự dịch chuyển từ chợ truyền thống (GT) sang kênh hiện đại (MT) đang diễn ra cực kỳ mạnh. Điều này thể hiện qua việc thị phần kênh siêu thị mini tăng 0,5%, và riêng tại thị trường nông thôn, sự dịch chuyển này tăng 1,3%. Theo ông Danny Lê, điều này khẳng định chiến lược 5 năm của Masan (về việc mức độ thâm nhập của kênh MT tăng từ 12% lên 30% thị phần) đang bắt đầu xảy ra, và ông dự đoán đến năm 2029-2030, kênh MT sẽ chiếm 25-30% thị trường.</p>\r\n\r\n<p>Về kết quả kinh doanh của Tập đoàn Masan, hầu hết các nền tảng (WinCommerce, Masan MEATLife, Phúc Long, Masan High-Tech Materials) đều tăng trưởng hơn 20%.</p>\r\n\r\n<p>Về tình hình tài chính, tỷ lệ nợ ròng/EBITDA đã được cải thiện xuống còn 2,8 lần (so với chiến lược trung hạn là 2,5 lần). Lượng tiền mặt trên bảng cân đối tăng gần 30% so với quý 2 nhờ dòng tiền mạnh mẽ tạo ra từ kinh doanh.</p>\r\n\r\n<p>Tại WinCommerce (WCM), doanh thu đã tăng gần 22% và EBITDA tăng gần 60%, giúp biên EBITDA đạt gần 3%. Mạng lưới hiện có gần 4.300 cửa hàng và ghi nhận mức tăng trưởng LFL (tăng trưởng trên các cửa hàng hiện hữu) là 10,6%.</p>\r\n\r\n<p>Về kế hoạch mở rộng, tính đến tháng 10, WCM đã mở lũy kế 550 cửa hàng và tự tin đạt kế hoạch 700+ cửa hàng mới cho cả năm 2025. Với kết quả này, công ty tự tin với kế hoạch mở thêm 1.000 đến 1.500 cửa hàng trong năm 2026, tiếp tục tập trung vào miền Bắc và miền Trung.</p>\r\n\r\n<p>Cột mốc quan trọng là quý III ghi nhận quý đầu tiên cả 2 mô hình Minimart (WinMart+) và Siêu thị lớn (WinMart) cùng đạt lợi nhuận trước thuế dương. Trong 4-5 năm qua, WCM tập trung ổn định nền tảng Minimart, và bây giờ là lúc tập trung vào chuỗi Siêu thị lớn. Năm nay, WCM đặt mục tiêu cải tạo 50 siêu thị, tập trung thay đổi môi trường mua sắm, đẩy mạnh hàng tươi sống, hàng chế biến sẵn và phi thực phẩm. Kết quả của chiến lược này rất rõ, nếu như trước đây LFL của kênh siêu thị chỉ từ 0-2% thì quý III năm nay đã tăng trưởng LFL gần 10%.</p>\r\n\r\n<p>Song song đó, mô hình nông thôn tiếp tục là động lực tăng trưởng chính trong 3-5 năm tới, khi ghi nhận mức tăng trưởng 44% trong quý 3 (với LFL gần 20%) và biên EBITDA tại cửa hàng đạt gần 10%.</p>\r\n\r\n<p>Về Masan Consumer (MCH), doanh thu quý III giảm 5,9%, EBITDA giảm 7,4% và lợi nhuận sau thuế giảm gần 19%, một phần do ảnh hưởng của việc chia cổ tức bằng tiền mặt.</p>\r\n\r\n<div class="ads_middle">\r\n<div class="banner fyi" data-position="Web_AdsArticleMiddle" id="adsWeb_AdsArticleMiddle">Ông Huỳnh Việt Thăng, Giám đốc Tài chính Masan Consumer lý giải, sự sụt giảm này chỉ diễn ra trong ngắn hạn, vì MCH đang triển khai hệ thống "Retail Supreme" - dự án nhằm tối ưu hóa toàn bộ tồn kho của nhà phân phối (NPP) và các điểm bán sỉ (wholesaler). Nguyên tắc của dự án là đưa hàng hóa MCH đến điểm bán lẻ gần người tiêu dùng nhất; do đó, lượng tồn kho tại các kênh trung gian sẽ giảm xuống, gây ảnh hưởng đến doanh thu nhập hàng của MCH trong quý III. Dự án này đã hoàn tất 100% trên 34 tỉnh thành vào đầu tháng 9 và MCH đang thấy những dấu hiệu tích cực trở lại từ tháng 10.</div>\r\n</div>\r\n\r\n<p>Ngoài ra, thị trường cũng bị ảnh hưởng bởi thay đổi chính sách thuế. Từ tháng 6/2025, Nhà nước yêu cầu các hộ kinh doanh (doanh thu trên 1 tỷ đồng) phải phát hành hóa đơn điện tử. Theo thông tin, từ 01/01/2026, tất cả hộ kinh doanh sẽ phải chuyển từ thuế khoán sang kê khai. Ông Thăng cho biết MCH đã chủ động đón đầu việc này thông qua chuyển đổi số và định danh từng điểm bán.</p>\r\n\r\n<p>Chi tiết về "Retail Supreme", ông Danny Lê cho biết dự án này thay đổi 3 thứ: Con người, công nghệ và kết nối. Cụ thể, dự án tái cấu trúc đội ngũ thành "đại diện kinh doanh", quản lý theo khu vực; ứng dụng công nghệ, phần mềm mới, và tính năng gợi ý đơn hàng; đồng thời cho phép đại diện kinh doanh kết nối trực tiếp với điểm bán lẻ.</p>\r\n\r\n<p>Kết quả ban đầu của chiến lược này rất tích cực: độ phủ trực tiếp của MCH tăng 40%, đạt 345.000 điểm bán; sự phụ thuộc vào kênh sỉ giảm mạnh từ 60% xuống còn 30%. Về hiệu suất, nhân viên bán hàng có thể phục vụ tăng 50% số điểm bán và mỗi đơn hàng tăng 50% số lượng SKU, trong khi chi phí vẫn duy trì như cũ.</p>\r\n\r\n<p>Đặc biệt, các khu vực triển khai Giai đoạn 1-3 (từ 9/2024) mất 6-9 tháng để quay lại doanh thu bình quân, nhưng các khu vực Giai đoạn 4-6 (triển khai gần đây) chỉ mất 3 tháng. Như vậy, thời gian phục hồi đã giảm đi một nửa, và đây là lý do MCH tự tin quý IV sẽ tăng trưởng trở lại.</p>\r\n\r\n<p>Tại Masan MEATLife (MML), đơn vị ghi nhận tăng 23% doanh thu trong quý III. Quan trọng nhất, đây là năm đầu tiên MML đạt lợi nhuận bền vững sau khi bán mảng thức ăn gia súc. Tất cả các sản phẩm, bao gồm gà, heo, và thịt chế biến, đều tăng trưởng 2 chữ số. Mảng thịt chế biến được xác định là động lực lợi nhuận tương lai, khi các sản phẩm đổi mới sáng tạo đã đóng góp 33% vào doanh thu mảng này.</p>\r\n\r\n<p>Sự cộng hưởng giữa MML và WCM cũng đang tiếp tục gia tăng. Hiện MML chiếm 65% thị phần đạm động vật trong WCM. Doanh thu MML/ngày/cửa hàng WCM tăng 20%, đạt 2,3 triệu/ngày, và MML đã đóng góp 3% trong tổng số 11% tăng trưởng LFL của WCM. Về hiệu quả, biên lợi nhuận gộp tăng nhẹ lên 27,6% (từ 26,4%) và MML tin rằng con số này sẽ tăng lên trên 30% khi thịt chế biến chiếm tỷ trọng cao hơn.</p>\r\n\r\n<p>Mục tiêu MML đang theo đuổi là tỷ lệ sử dụng heo thịt trong sản xuất thịt chế biến (tối ưu giá trị) hiện đã tăng 8% so với năm trước nhờ các hoạt động tối ưu như tẩm ướp, chế biến.</p>\r\n\r\n<p><strong><em>Phần thảo luận:</em></strong></p>\r\n\r\n<div class="ads_middle">\r\n<div class="banner fyi" data-position="Web_AdsArticleMiddle1" id="adsWeb_AdsArticleMiddle1"><strong>Các yếu tố chính giúp MSN cải thiện lợi nhuận so với quý III/2024? MSN có đạt kế hoạch năm nay không?</strong></div>\r\n</div>\r\n\r\n<p>Bà Đoàn Thị Mỹ Duyên, Giám đốc tài chính MSN: Tất cả các công ty của MSN đều có kết quả doanh thu và lợi nhuận tăng hơn 20%, ngoại trừ MCH giảm 6%. Hiện tại MSN đã đạt được 90% kế hoạch đặt ra, dự kiến đạt 130% so với kế hoạch đặt ra.</p>\r\n\r\n<p><strong>Tiến độ chuyển sàn của MCH?</strong></p>\r\n\r\n<p>Phó TGĐ Michael Hung Nguyen: Đây là dự án từ đầu năm, đã xin ý kiến cổ đông về vấn đề chuyển sàn. Hiện MCH gần như tài liệu đã xong hết và đã sẵn sàng và phía tư vấn niêm yết là các ngân hàng đầu tư cũng đang giúp công ty chuẩn bị hoàn tất. Hiện tại tuỳ thuộc vào kết quả kinh doanh quý IV và quý I sắp tới cũng như tình hình thị trường sẽ quyết định thời điểm chuyển sàn của MCH. Hiện tại thị trường có nhiều thông tin tốt nên chúng tôi tự tin về việc IPO của MCH. Vốn hoá MCH khả năng rất cao để vào VN30, ngày chính xác sẽ công bố thông tin sau cho các cổ đông biết.</p>\r\n\r\n<p><strong>Về Wincommerce, kế hoạch mở mới cửa hàng trong quý IV/2025?</strong></p>\r\n\r\n<p>Ông Phan Nguyễn Trọng Huy, Giám đốc tài chính Wincommerce: Tính tới thời điểm tháng 10/2025 chúng tôi đã mở luỹ kế 550 cửa hàng, chúng tôi tự tin đạt kế hoạch mở từ 700 cửa hàng mở mới trong năm nay.</p>\r\n\r\n<p><strong>Tầm nhìn của ban lãnh đạo về cạnh tranh của khu vực phía Bắc đối với Wincommerce, đặc biệt khi đang có nhiều chuỗi mới được mở tại khu vực này?</strong></p>\r\n\r\n<p>Ông Phan Nguyễn Trọng Huy, Giám đốc tài chính Wincommerce: Cạnh tranh ở miền Bắc vốn là phía mạnh của Wincommerce. Định vị và cách tiếp cận khách hàng của Wincommerce khác với những công ty khác trên thị trường. Khi các công ty đối thủ bắt đầu vào thị trường miền Trung thì doanh thu của chúng tôi gần như không bị ảnh hưởng nhiều. Chúng tôi sẽ cân bằng các thị trường Bắc Trung Nam trong thời gian sắp tới.</p>\r\n\r\n<p><strong>Sau MCH thì công ty có kế hoạch niêm yết nào khác hay không, có kế hoạch nào để giảm tỷ lệ nợ vay hay không?</strong></p>\r\n\r\n<div class="ads_middle">\r\n<div class="banner fyi" data-position="Web_AdsArticleMiddle2" id="adsWeb_AdsArticleMiddle2">Phó TGĐ Michael Hung Nguyen: MSN hiện đang tập trung vào câu chuyện IPO MCH và Masan High-tech Materials đang tích cực tìm kiếm nhà đầu tư chiến lược, việc niêm yết các công ty khác thì công ty sẽ cân nhắc còn hiện tại chưa có gì mới để chia sẻ với cổ đông.</div>\r\n</div>\r\n\r\n<p><strong>Về Masan MEATLife: Tỷ trọng doanh thu thịt chế biến mục tiêu trong các năm tới là bao nhiêu?</strong></p>\r\n\r\n<p>Tổng giám đốc Danny Le: Kế hoạch năm sau với mục tiêu mở mới 1.000-1.500 cửa hàng của của Wincommerce thì Masan MEATLife sẽ đi theo gồm thịt mát, thịt tẩm ướp, thịt chế biến. Tỷ trọng doanh thu trên thịt chế biến hiện đang 50%, chúng tôi muốn hướng đến tầm 60-65% doanh thu thịt chế biến.</p>', 'price_change_pct': 0.00126263, 'related_ticker': 'MSN', 'fetched_at': '2026-01-04 03:40:16'}, {'id': '8699437', 'author': None, 'friendly_sub_title': '', 'news_source_link': 'https://www.hsx.vn/vi/tin-tuc/msn-thong-cao-bao-chi-ve-ket-qua-kinh-doanh-quy-32025/2413539', 'created_at': None, 'public_date': 1761573733000, 'updated_at': None, 'lang_code': 'vi', 'news_id': '11774471', 'news_short_content': 'Công ty Cổ phần Tập đoàn MaSan thông báo thông cáo báo chí về kết quả kinh doanh quý 3/2025 như sau:', 'news_full_content': '<p>Công ty Cổ phần Tập đoàn MaSan thông báo thông cáo báo chí về kết quả kinh doanh quý 3/2025 như sau:</p><table width="100%" style=\'text-align: left;border=0\'><tr><td colspan=\'2\'><hr /></td></tr><tr><td colspan=\'2\'>Tài liệu đính kèm</td></tr><tr><td>\xa0</td><td><a href="https://cmsv5.fiingroup.vn/medialib/FG/2025/2025-10/2025-10-27/MSN/20251027--MSN--Thong-cao-bao-chi-ve-ket-qua-kinh-doanh-Quy-3.2025--signed.pdf" title="Tải về" download>20251027--MSN--Thong-cao-bao-chi-ve-ket-qua-kinh-doanh-Quy-3.2025--signed.pdf</a></td></tr></table>', 'price_change_pct': -0.01008827, 'related_ticker': 'MSN', 'fetched_at': '2026-01-04 03:40:16'}, {'id': '8699438', 'author': None, 'friendly_sub_title': '', 'news_source_link': 'https://www.hsx.vn/vi/tin-tuc/msn-link-cong-bo-bctc-quy-32025-va-giai-trinh-bien-dong-ln/2413521', 'created_at': None, 'public_date': 1761573684000, 'updated_at': None, 'lang_code': 'vi', 'news_id': '11774492', 'news_short_content': 'Công ty Cổ phần Tập đoàn MaSan thông báo link công bố BCTC quý 3/2025 và giải trình biến động LN như sau:', 'news_full_content': '<p>Công ty Cổ phần Tập đoàn MaSan thông báo link công bố BCTC quý 3/2025 và giải trình biến động LN như sau:</p><table width="100%" style=\'text-align: left;border=0\'><tr><td colspan=\'2\'><hr /></td></tr><tr><td colspan=\'2\'>Tài liệu đính kèm</td></tr><tr><td>\xa0</td><td><a href="https://cmsv5.fiingroup.vn/medialib/FG/2025/2025-10/2025-10-27/MSN/20251027--MSN--CBTT-link-BCTC-Q3.2025-va-Giai-trinh-bien-dong-loi-nhuan--signed.pdf" title="Tải về" download>20251027--MSN--CBTT-link-BCTC-Q3.2025-va-Giai-trinh-bien-dong-loi-nhuan--signed.pdf</a></td></tr></table>', 'price_change_pct': -0.01008827, 'related_ticker': 'MSN', 'fetched_at': '2026-01-04 03:40:16'}, {'id': '8699375', 'author': None, 'friendly_sub_title': '', 'news_source_link': 'https://dttc.sggp.org.vn/masan-ghi-nhan-loi-nhuan-quy-iii-gap-14-lan-cung-ky-post127723.html', 'created_at': None, 'public_date': 1761566160000, 'updated_at': None, 'lang_code': 'vi', 'news_id': '11774267', 'news_short_content': 'Kết quả quý III đánh dấu cột mốc quan trọng của Masan trong hành trình hiện đại hóa toàn diện ngành tiêu dùng - bán lẻ Việt Nam một cách bền vững và có lợi nhuận.', 'news_full_content': '<p><b>Nền tảng vững chắc tăng trưởng bền vững</b></p>\r\n\r\n<p>CTCP Tập đoàn Masan (HoSE: MSN) vừa công bố báo cáo tài chính chưa kiểm toán cho quý III và 9 tháng đầu năm 2025.</p>\r\n\r\n<p>Chia sẻ về kết quả kinh doanh, TS. Nguyễn Đăng Quang, Chủ tịch Tập đoàn Masan cho biết: “Chúng tôi kỳ vọng sẽ tạo ra những cộng hưởng mạnh mẽ thông qua việc xây dựng một chương trình hội viên thống nhất, kết nối kênh bán lẻ hiện đại của WinCommerce với mô hình phân phối trực tiếp của Masan Consumer, qua đó mở rộng khả năng tiếp cận và phục vụ hiệu quả hơn các điểm bán truyền thống trên toàn quốc. Đây sẽ là nền tảng vững chắc cho tăng trưởng bền vững và tạo dựng giá trị lâu dài cho cổ đông”.</p>\r\n\r\n<p>Cụ thể, doanh thu quý III của MSN đạt 21.164 tỷ đồng (tăng 9,7%), lợi nhuận sau thuế (LNST) đạt 1.866 tỷ đồng, gấp 1,4 lần so với cùng kỳ. Tính chung, doanh thu 9 tháng đầu năm đạt 58.376 tỷ đồng (tăng 8%), LNST đạt 4.468 tỷ đồng (tăng 63,9% so với cùng kỳ) tương đương hoàn thành hơn 90% kế hoạch cả năm.</p>\r\n\r\n<p>Tăng trưởng được thúc đẩy bởi hiệu quả lợi nhuận mạnh mẽ tại WCM, MML, PLH, cùng với đóng góp lợi nhuận tốt hơn từ TCB và việc thoái hợp nhất H.C. Starck (HCS), dù MCH đang trong giai đoạn đầu hoàn thiện mô hình phân phối mới cũng như sự gia tăng nhẹ của chi phí tài chính thuần.</p>\r\n\r\n<p>Đóng góp vào tăng trưởng chung của tập đoàn, WinCommerce (WCM), đơn vị sở hữu và vận hành chuỗi siêu thị WinMart và cửa hàng tiện lợi WinMart+/WiN, trong quý III đạt 10.544 tỷ đồng doanh thu (tăng 22,6% so với cùng kỳ), LNST đạt 175 tỷ đồng (tăng 8,7 so với cùng kỳ), tương ứng biên lợi nhuận đạt 1,7%. Doanh thu 9 tháng đạt 28.459 tỷ đồng (tăng 16,6% so với cùng kỳ), LNST đạt 243 tỷ đồng (tăng 447 tỷ đồng so với cùng kỳ).</p>\r\n\r\n<p>Từ đầu năm đến nay, WCM đã mở ròng 464 cửa hàng, vượt mục tiêu cơ sở và hướng tới hoàn thành kịch bản cao vào cuối năm. Đáng chú ý, hơn 80% tổng số cửa hàng mới đã đạt điểm hòa vốn ở cấp độ EBITDA cửa hàng, củng cố vị thế của WCM là nhà bán lẻ hiện đại có lợi nhuận lớn nhất Việt Nam theo quy mô điểm bán, với khoảng 4.500 cửa hàng dự kiến trên toàn quốc vào cuối năm.</p>\r\n\r\n<p>Trong khi đó, Masan Consumer Corporation (MCH), công ty chuyên sản xuất và phân phối nhiều sản phẩm thực phẩm và đồ uống, ghi nhận doanh thu 7.517 tỷ đồng trong quý III, giảm 5,9% so với cùng kỳ, với biên lợi nhuận EBIT đạt 24,2%. Doanh thu 9 tháng đầu năm đạt 21.281 tỷ đồng (giảm 3,1% so với cùng kỳ), EBIT đạt 4.965 tỷ đồng (giảm 4,2% so với cùng kỳ), LNST đạt 4.660 tỷ đồng (giảm 16,1% so với cùng kỳ). Tuy nhiên kết quả đã ghi nhận sự cải thiện theo từng tháng trong quý và theo quý, tạo đà tăng trưởng cho các giai đoạn tiếp theo.</p>\r\n\r\n<p>Tính đến quý III, số lượng điểm bán hoạt động trung bình đạt 345.000 điểm, tăng 40% so với cùng kỳ, trong khi năng suất đội ngũ bán hàng trung bình cải thiện lên 102 điểm bán/nhân viên bán hàng/quý, tăng 50% so với cùng kỳ.</p>\r\n\r\n<p>Doanh thu thuần MCH cải thiện dần theo quý, khi mức giảm doanh thu trong quý III thu hẹp còn 5,9% so với cùng kỳ, so với mức giảm 15,1% trong quý II. Song song đó, doanh thu từ kênh MT tăng 12,5% và xuất khẩu tăng 14,8% so với cùng kỳ, phản ánh sự chuyển dịch mang tính cấu trúc sang mô hình bán lẻ chính quy và hiệu quả vận hành được nâng cao của MCH tại các thị trường quốc tế.</p>\r\n\r\n<p>Masan MEATLife (MML), hoạt động trong lĩnh vực cung cấp thịt tươi có thương hiệu, trong quý III vừa qua đạt doanh thu 2.384 tỷ đồng (tăng 23,2% so với cùng kỳ), EBIT đạt 144 tỷ đồng (tăng 3,2x so với cùng kỳ), LNST đạt 101 tỷ đồng (tăng 5,2x so với cùng kỳ).</p>\r\n\r\n<p>Doanh thu 9 tháng đạt 6.794 tỷ đồng (tăng 24,7% so với cùng kỳ), EBIT đạt 310 tỷ đồng (tăng 5,7x so với cùng kỳ), LNST đạt 466 tỷ đồng (tăng 526 tỷ đồng so với cùng kỳ), nhờ tiếp tục vận hành hiệu quả với sản lượng bán tăng trên tất cả các mảng (chăn nuôi, thịt tươi và thịt chế biến), sự tăng cường hợp tác giữa MML với WCM và giá trị heo thịt được tối ưu.</p>\r\n\r\n<p>Một phần lợi nhuận mà Masan ghi nhận từ Techcombank (TCB) trong quý III đạt 1.242 tỷ đồng, tăng 9,4% so với cùng kỳ.</p>\r\n\r\n<p><b>Tiếp tục tập trung tăng trưởng doanh thu và lợi nhuận</b></p>\r\n\r\n<p>Tùy thuộc điều kiện kinh tế vĩ mô và sự phục hồi của thị trường tiêu dùng, Masan tiếp tục tập trung vào tăng trưởng doanh thu và lợi nhuận với trọng tâm là mảng kinh doanh cốt lõi tiêu dùng - bán lẻ.</p>\r\n\r\n<p>Dự kiến doanh thu thuần hợp nhất năm 2025 của Masan sẽ nằm trong khoảng từ 80.000-85.500 tỷ đồng, tương ứng với mức tăng trưởng LFL từ 7-14% so với cùng kỳ (sau điều chỉnh cho việc tách hợp nhất HCS).</p>\r\n\r\n<p>Trong năm 2025, tổng doanh thu hợp nhất, không bao gồm MHT, dự kiến sẽ nằm trong khoảng từ 74.013-78.013 tỷ đồng, tương ứng với mức tăng trưởng từ 8-13% so với cùng kỳ.</p>\r\n\r\n<p>WCM đặt mục tiêu nâng cao hiệu quả vận hành, tối ưu chi phí và đảm bảo tính nhất quán trong triển khai trên toàn mạng lưới khoảng 4.500 cửa hàng. WCM dự kiến đạt doanh thu thuần từ 35.600-36.900 tỷ đồng trong năm 2025, tương ứng mức tăng trưởng 8–12% so với cùng kỳ.</p>\r\n\r\n<p>Trong khi đó, MML dự kiến sẽ mang về doanh thu từ 8.250-8.749 tỷ đồng, tăng trưởng từ 8-14% so với cùng kỳ. Kết quả này sẽ đạt được trên hành trình liên tục chuyển đổi để trở thành công ty chế biến thịt của MML và việc hợp tác sâu hơn với WinCommerce.</p>\r\n\r\n<p>Trong nửa cuối năm 2025, MML sẽ đẩy mạnh đổi mới trong mảng thịt chế biến, tập trung chiến lược vào việc nâng cao giá trị heo thịt thông qua gia tăng tỷ lệ sử dụng trong sản phẩm chế biến và tối ưu hóa giá trị từ các sản phẩm phụ.</p>', 'price_change_pct': -0.01008827, 'related_ticker': 'MSN', 'fetched_at': '2026-01-04 03:40:16'}, {'id': '8445922', 'author': None, 'friendly_sub_title': '', 'news_source_link': 'https://www.hsx.vn/vi/tin-tuc/msn-nghi-quyet-hdqt-uy-quyen-cho-tgd-quyet-dinh-ve-cong-dau-cua-cong-ty/2403994', 'created_at': None, 'public_date': 1757698895000, 'updated_at': None, 'lang_code': 'vi', 'news_id': '11709889', 'news_short_content': '', 'news_full_content': '<p>Công ty Cổ phần Tập đoàn MaSan công bố Nghị quyết HĐQT ủy quyền cho TGĐ quyết định về công dấu của Công ty như sau:</p><table width="100%" style=\'text-align: left;border=0\'><tr><td colspan=\'2\'><hr /></td></tr><tr><td colspan=\'2\'>Tài liệu đính kèm</td></tr><tr><td>\xa0</td><td><a href="https://cmsv5.fiingroup.vn/medialib/FG/2025/2025-09/2025-09-12/MSN/20250912--MSN--NQ-HDQT-uy-quyen-cho-TGD-quyet-dinh-ve-con-dau-cua-cong-ty--signed.pdf" title="Tải về" download>20250912--MSN--NQ-HDQT-uy-quyen-cho-TGD-quyet-dinh-ve-con-dau-cua-cong-ty--signed.pdf</a></td></tr></table>', 'price_change_pct': 0.04878049, 'related_ticker': 'MSN', 'fetched_at': '2026-01-04 03:40:16'}, {'id': '8451171', 'author': None, 'friendly_sub_title': '', 'news_source_link': 'https://www.hsx.vn/vi/tin-tuc/msn-nghi-quyet-hdqt-uy-quyen-cho-tgd-quyet-dinh-ve-con-dau-cua-