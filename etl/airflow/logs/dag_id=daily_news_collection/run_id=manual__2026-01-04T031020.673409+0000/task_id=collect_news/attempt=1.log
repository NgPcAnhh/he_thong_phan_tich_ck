49_VI_Baocaotaichinh_kiemtoan_2025.pdf.pdf" title="Tải về" download>000000015317149_VI_Baocaotaichinh_kiemtoan_2025.pdf.pdf</a></td></tr><tr><td>\xa0</td><td><a href="https://cmsv5.fiingroup.vn/medialib/FG/2025/2025-08/2025-08-13/PVH/000000015317150_EN_ExplanationsRelating_of_the_interim_Financial_statements_in_2025.pdf" title="Tải về" download>000000015317150_EN_ExplanationsRelating_of_the_interim_Financial_statements_in_2025.pdf</a></td></tr><tr><td>\xa0</td><td><a href="https://cmsv5.fiingroup.vn/medialib/FG/2025/2025-08/2025-08-13/PVH/000000015317142_EN_AuditeFidFinancialStatements_2025.pdf.pdf" title="Tải về" download>000000015317142_EN_AuditeFidFinancialStatements_2025.pdf.pdf</a></td></tr></table>', 'price_change_pct': nan, 'related_ticker': 'PVH', 'fetched_at': '2026-01-04 03:31:54'}, {'id': '8126330', 'author': None, 'friendly_sub_title': '', 'news_source_link': 'https://hnx.vn/vi-vn/m-tin-tuc-hnx/tintuc-574288-1.html', 'created_at': None, 'public_date': 1754265420000, 'updated_at': None, 'lang_code': 'vi', 'news_id': '11660312', 'news_short_content': 'Báo cáo quản trị công ty bán niên 2025', 'news_full_content': '<table width="100%" style=\'text-align: left;border=0\'><tr><td colspan=\'2\'><hr /></td></tr><tr><td colspan=\'2\'>Tài liệu đính kèm</td></tr><tr><td>\xa0</td><td><a href="https://cmsv5.fiingroup.vn/medialib/FG/2025/2025-08/2025-08-03/PVH/000000015264479_EN_ReportOnCorporateGovernance_6thangdaunam2025.pdf.pdf" title="Tải về" download>000000015264479_EN_ReportOnCorporateGovernance_6thangdaunam2025.pdf.pdf</a></td></tr><tr><td>\xa0</td><td><a href="https://cmsv5.fiingroup.vn/medialib/FG/2025/2025-08/2025-08-03/PVH/000000015264489_VI_Baocaoquantri_6thangdaunam2025.pdf.pdf" title="Tải về" download>000000015264489_VI_Baocaoquantri_6thangdaunam2025.pdf.pdf</a></td></tr></table>', 'price_change_pct': nan, 'related_ticker': 'PVH', 'fetched_at': '2026-01-04 03:31:54'}, {'id': '7962647', 'author': None, 'friendly_sub_title': '', 'news_source_link': 'https: