0242025_signed.pdf" title="Tải về" download>20251229--HSG--Giai-trinh-KQKD-rieng-cty-me-NDTC-20242025_signed.pdf</a></td></tr><tr><td>\xa0</td><td><a href="https://cmsv5.fiingroup.vn/medialib/FG/2025/2025-12/2025-12-29/HSG/20251229--HSG--Giai-trinh-KQKD-hop-nhat-NDTC-20242025_signed.pdf" title="Tải về" download>20251229--HSG--Giai-trinh-KQKD-hop-nhat-NDTC-20242025_signed.pdf</a></td></tr></table>', 'price_change_pct': 0.00934579, 'related_ticker': 'HSG', 'fetched_at': '2026-01-04 03:48:32'}, {'id': '9039173', 'author': None, 'friendly_sub_title': '', 'news_source_link': 'https://www.hsx.vn/vi/tin-tuc/hsg-cbtt-thanh-lap-chi-nhanh--tong-kho-yen-bai/2426177', 'created_at': None, 'public_date': 1766658052000, 'updated_at': None, 'lang_code': 'vi', 'news_id': '11826680', 'news_short_content': 'Công ty Cổ phần Tập đoàn Hoa Sen thông báo thành lập Chi nhánh - Tổng kho Yên Bái như sau:', 'news_full_content': '<p>Công ty Cổ phần Tập đoàn Hoa Sen thông báo thành lập Chi nhánh - Tổng kho Yên Bái như sau:</p><table width="100%" style=\'text-align: left;border=0\'><tr><td colspan=\'2\'><hr /></td></tr><tr><td colspan=\'2\'>Tài liệu đính kèm</td></tr><tr><td>\xa0</td><td><a href="https://cmsv5.fiingroup.vn/medialib/FG/2025/2025-12/2025-12-25/HSG/20251224--HSG--CBTT30Thanh-lap-Chi-nhanh--Tong-kho-Yen-Bai_signed.pdf" title="Tải về" download>20251224--HSG--CBTT30Thanh-lap-Chi-nhanh--Tong-kho-Yen-Bai_signed.pdf</a></td></tr></table>', 'price_change_pct': 0.00943396, 'related_ticker': 'HSG', 'fetched_at': '2026-01-04 03:48:32'}, {'id': '9026558', 'author': None, 'friendly_sub_title': '', 'news_source_link': 'https://www.tinnhanhchungkhoan.vn/hoa-sen-hsg-muon-thanh-lap-mot-cong-ty-tai-hai-phong-voi-von-dieu-le-300-ty-dong-post382569.html', 'created_at': None, 'public_date': 1766472540000, 'updated_at': None, 'lang_code': 'vi', 'news_id': '11824453', 'news_short_content': 'Công ty cổ phần Tập đoàn Hoa Sen (mã HSG - sàn HOSE) sẽ thành lập pháp nhân mới hoạt động trong lĩnh vực sản xuất sắt, thép, gang tại Hải Phòng.', 'news_full_content': '<p>Hoa Sen thông qua chủ trương thành lập Công ty TNHH MTV Hoa Sen Hải Phòng do Hoa Sen sở hữu 100% vốn điều lệ.</p>\r\n\r\n<p>Hoa Sen Hải Phòng có địa chỉ tại Lô CN21-01, khu phi thuế quan và khu công nghiệp Nam Đình Vũ (khu 1) thuộc khu kinh tế Đình Vũ – Cát Hải, phường Đông Hải, Hải Phòng; vốn điều lệ 300 tỷ đồng; hoạt động chính trong lĩnh vực sản xuất sắt, thép, gang.</p>\r\n\r\n<p>Về nhân sự tại pháp nhân mới, ông Nguyễn Ngọc Huy sinh năm 1979 sẽ là Chủ tịch HĐQT, đồng thời là người đại diện thứ nhất tại công ty; ông Nguyễn Tấn Hoà sẽ giữ vị trí Giám đốc kiêm người đại diện pháp luật thứ hai tại Hoa Sen Hải Phòng; và bà Nguyễn Thị Thanh Tuyền sẽ được bổ nhiệm vị trí Kế toán trưởng.</p>\r\n\r\n<div class="ads_middle">\r\n<div class="banner fyi" data-position="Web_AdsArticleMiddle" id="adsWeb_AdsArticleMiddle">\xa0</div>\r\n</div>\r\n\r\n<table class="picture">\r\n\t<tbody>\r\n\t\t<tr>\r\n\t\t\t<td class="pic"><img alt="Danh sách công ty con và liên kết của Hoa Sen tại thời điểm 30/9/2025." data-height="1382" data-image-id="527632" data-original="" data-photo-original-src="" data-src="" data-width="1368" height="" sizes="" src="https://cdn.fiingroup.vn/medialib/127379/I/2025/12/23/screenshot20251222at2110212135797_07230233600690700.png" srcset="" title="Danh sách công ty con và liên kết của Hoa Sen tại thời điểm 30/9/2025." width="" /></td>\r\n\t\t</tr>\r\n\t\t<tr>\r\n\t\t\t<td class="caption">\r\n\t\t\t<p>Danh sách công ty con và liên kết của Hoa Sen tại thời điểm 30/9/2025.</p>\r\n\t\t\t</td>\r\n\t\t</tr>\r\n\t</tbody>\r\n</table>\r\n\r\n<p>Được biết, tại thời điểm 30/9/2025, Hoa Sen đang sở hữu 9 công ty con, 2 công ty liên kết và 7.932 nhân viên.</p>\r\n\r\n<p>Về hoạt động kinh doanh, trong niên độ tài chính 2024–2025 (từ ngày 1/10/2024 – 30/9/2025), Hoa Sen ghi nhận doanh thu giảm 7% xuống 36.537,8 tỷ đồng, nhưng lợi nhuận ròng lại tăng 42,1% lên 731,5 tỷ đồng nhờ biên lợi nhuận gộp cải thiện từ 10,9% lên 12,4%. Điểm sáng của Hoa Sen nằm ở khả năng quản trị dòng tiền khi mà doanh nghiệp giảm 1.513,6 tỷ đồng hàng tồn kho, giảm 796,5 tỷ đồng phải thu ngắn hạn và trả thêm 960,2 tỷ đồng nợ vay ngắn hạn. Nhờ đó, dòng tiền hoạt động dương 3.659,8 tỷ đồng (cùng kỳ âm 1.414,9 tỷ đồng). Chính sự thận trọng này giúp Hoa Sen củng cố năng lực tài chính, tạo dư địa ứng phó rủi ro trong bối cảnh thị trường thép khó lường.</p>\r\n\r\n<p>Đóng cửa phiên giao dịch ngày 22/12, cổ phiếu HSG tăng 150 đồng, lên 16.050 đồng/cổ phiếu.</p>', 'price_change_pct': -0.01557632, 'related_ticker': 'HSG', 'fetched_at': '2026-01-04 03:48:32'}, {'id': '9021284', 'author': None, 'friendly_sub_title': '', 'news_source_link': 'https://www.hsx.vn/vi/tin-tuc/hsg-cbtt-thanh-lap-cong-ty-tnhh-mtv-hoa-sen-hai-phong/2425291', 'created_at': None, 'public_date': 1766402085000, 'updated_at': None, 'lang_code': 'vi', 'news_id': '11824016', 'news_short_content': 'Công ty Cổ phần Tập đoàn Hoa Sen thông báo  thành lập công ty TNHH MTV Hoa Sen Hải Phòng như sau:', 'news_full_content': '<p>Công ty Cổ phần Tập đoàn Hoa Sen thông báo \xa0thành lập công ty TNHH MTV Hoa Sen Hải Phòng như sau:</p><table width="100%" style=\'text-align: left;border=0\'><tr><td colspan=\'2\'><hr /></td></tr><tr><td colspan=\'2\'>Tài liệu đính kèm</td></tr><tr><td>\xa0</td><td><a href="https://cmsv5.fiingroup.vn/medialib/FG/2025/2025-12/2025-12-22/HSG/20251219--HSG--CBTT29Thanh-lap-Cty-TNHH-MTV-Hoa-Sen-Hai-Phong_signed.pdf" title="Tải về" download>20251219--HSG--CBTT29Thanh-lap-Cty-TNHH-MTV-Hoa-Sen-Hai-Phong_signed.pdf</a></td></tr></table>', 'price_change_pct': 0.00943396, 'related_ticker': 'HSG', 'fetched_at': '2026-01-04 03:48:32'}, {'id': '8872866', 'author': None, 'friendly_sub_title': '', 'news_source_link': 'https://www.hsx.vn/vi/tin-tuc/hsg-cbtt-cap-nhat-nganh-nghe-kinh-doanh/2419997', 'created_at': None, 'public_date': 1764090179000, 'updated_at': None, 'lang_code': 'vi', 'news_id': '11803363', 'news_short_content': 'Công ty Cổ phần Tập đoàn Hoa Sen thông báo  cập nhật ngành nghề kinh doanh như sau:', 'news_full_content': '<p>Công ty Cổ phần Tập đoàn Hoa Sen thông báo \xa0cập nhật ngành nghề kinh doanh như sau:</p><table width="100%" style=\'text-align: left;border=0\'><tr><td colspan=\'2\'><hr /></td></tr><tr><td colspan=\'2\'>Tài liệu đính kèm</td></tr><tr><td>\xa0</td><td><a href="https://cmsv5.fiingroup.vn/medialib/FG/2025/2025-11/2025-11-25/HSG/20251124--HSG--CBTT27Cap-nhat-nganh-nghe-kinh-doanh_signed.pdf" title="Tải về" download>20251124--HSG--CBTT27Cap-nhat-nganh-nghe-kinh-doanh_signed.pdf</a></td></tr></table>', 'price_change_pct': -0.01183432, 'related_ticker': 'HSG', 'fetched_at': '2026-01-04 03:48:32'}, {'id': '8846188', 'author': None, 'friendly_sub_title': '', 'news_source_link': 'https://www.tinnhanhchungkhoan.vn/hoa-sen-hsg-se-bao-cao-tien-do-mua-lai-tu-50-den-100-trieu-co-phieu-trong-dai-hoi-sap-toi-post380755.html', 'created_at': None, 'public_date': 1763621940000, 'updated_at': None, 'lang_code': 'vi', 'news_id': '11797930', 'news_short_content': 'Công ty cổ phần Tập đoàn Hoa Sen (mã HSG - sàn HOSE) lên kế hoạch tổ chức Đại hội đồng cổ đông niên độ tài chính 2025 – 2026 vào đầu tháng 3/2026.', 'news_full_content': '<p>Ngày 5/12/2025 tới đây, Hoa Sen sẽ chốt danh sách cổ đông tham gia Đại hội đồng cổ đông niên độ tài chính 2025 – 2026, Đại hội dự kiến tổ chức ngày 7/3/2026 tại TP.HCM.</p>\r\n\r\n<p>Trong Đại hội sắp tới, bên cạnh Báo cáo kết quả kinh doanh niên độ tài chính 2024-2025, Hoa Sen còn thông qua kế hoạch kinh doanh niên độ tài chính 2025 – 2026, báo cáo tiến độ và tiếp tục triển khai cá chủ trương tái cấu trúc, chiến lược phát triển.</p>\r\n\r\n<p>Điểm đáng lưu ý, Hoa Sen sẽ báo cáo tiến độ triển khai chủ trương mua lại cổ phiếu.</p>\r\n\r\n<div class="ads_middle">\r\n<div class="banner fyi" data-position="Web_AdsArticleMiddle" id="adsWeb_AdsArticleMiddle">Trước đó, trong Đại hội đồng cổ đông niên độ 2024 – 2025, Hoa Sen đã thông qua kế hoạch mua lại từ 50 triệu cổ phiếu đến 100 triệu cổ phiếu, nguồn vốn thực hiện là thặng dư vốn cổ phần, lợi nhuận sau thuế chưa phân phối. Tuy nhiên, tính tới thời điểm hiện tại ngày 19/11, Hoa Sen vẫn không có động thái mua lại cổ phiếu dù giá thị trường đang giao dịch là 17.300 đồng/cổ phiếu, thấp hơn so với giá sổ sách tới ngày 30/9/2025 là 18.228 đồng/cổ phiếu.</div>\r\n</div>\r\n\r\n<p>Tại Đại hội đồng năm 2025, cổ đông cũng hoài nghi về nguồn tiền và khả năng mua lại nhưng Chủ tịch Lê Phước Vũ vẫn tự tin. Trong đó, ông Vũ khẳng định, Hoa Sen không thiếu tiền, Hoa Sen có hạn mức tín dụng lớn và chi phí thấp, đây là biện pháp dự phòng, Công ty có thể lên kế hoạch mua lại cổ phiếu và nếu vì lý do giá cổ phiếu giảm sâu dưới sổ sách thì mua có thể thực hiện mua lại. Tuy nhiên, thời điểm mua và giá mua thì cần xem xét, cũng như nếu cổ phiếu tăng cao, việc mua lại sẽ không được thực hiện như tờ trình.</p>\r\n\r\n<div class="ads_middle">\r\n<div class="banner fyi" data-position="Web_AdsArticleMiddle1" id="adsWeb_AdsArticleMiddle1">Trong đó, năm 2025, Hoa Sen lên kế hoạch lãi 500 tỷ đồng, khấu hao 800-900 tỷ đồng, vì vậy, dòng tiền khoảng 1.400 tỷ đồng từ hoạt động kinh doanh, dòng tiền từ hoạt động kinh doanh tạo ra trong năm 2025 đủ giúp Hoa Sen có tiền để mua lại cổ phiếu như tờ trình mua lại từ 50 đến 100 triệu cổ phiếu.</div>\r\n</div>\r\n\r\n<p>Về hoạt động kinh doanh, trong niên độ tài chính 2024–2025 (từ ngày 1/10/2024 – 30/9/2025), Hoa Sen ghi nhận doanh thu giảm 7% xuống 36.537,8 tỷ đồng, nhưng lợi nhuận ròng lại tăng 42,1% lên 731,5 tỷ đồng nhờ biên lợi nhuận gộp cải thiện từ 10,9% lên 12,4%. Điểm sáng của Hoa Sen nằm ở khả năng quản trị dòng tiền khi mà doanh nghiệp giảm 1.513,6 tỷ đồng hàng tồn kho, giảm 796,5 tỷ đồng phải thu ngắn hạn và trả thêm 960,2 tỷ đồng nợ vay ngắn hạn. Nhờ đó, dòng tiền hoạt động dương 3.659,8 tỷ đồng (cùng kỳ âm 1.414,9 tỷ đồng). Chính sự thận trọng này giúp Hoa Sen củng cố năng lực tài chính, tạo dư địa ứng phó rủi ro trong bối cảnh thị trường thép khó lường.</p>', 'price_change_pct': -0.01156069, 'related_ticker': 'HSG', 'fetched_at': '2026-01-04 03:48:32'}, {'id': '8840411', 'author': None, 'friendly_sub_title': '', 'news_source_link': 'https://www.hsx.vn/vi/tin-tuc/hsg-thong-bao-ngay-dkcc-to-chuc-dhdcd-thuong-nien-nien-do-tai-chinh-nam-20252026/2418738', 'created_at': None, 'public_date': 1763547126000, 'updated_at': None, 'lang_code': 'vi', 'news_id': '11796891', 'news_short_content': 'Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh thông báo ngày ĐKCC tổ chức ĐHĐCĐ thường niên niên độ tài chính năm 2025-2026 của Công ty Cổ phần Tập đoàn Hoa Sen như sau:', 'news_full_content': '<p>Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh thông báo ngày ĐKCC tổ chức ĐHĐCĐ thường niên niên độ tài chính năm 2025-2026 của Công ty Cổ phần Tập đoàn Hoa Sen như sau:</p><table width="100%" style=\'text-align: left;border=0\'><tr><td colspan=\'2\'><hr /></td></tr><tr><td colspan=\'2\'>Tài liệu đính kèm</td></tr><tr><td>\xa0</td><td><a href="https://cmsv5.fiingroup.vn/medialib/FG/2025/2025-11/2025-11-19/HSG/20251118--HSG--TB-2162-vv-ngay-dkcc-de-to-chuc-DHCD-TN.pdf" title="Tải về" download>20251118--HSG--TB-2162-vv-ngay-dkcc-de-to-chuc-DHCD-TN.pdf</a></td></tr></table>', 'price_change_pct': 0.0, 'related_ticker': 'HSG', 'fetched_at': '2026-01-04 03:48:32'}, {'id': '8811796', 'author': None, 'friendly_sub_title': '', 'news_source_link': 'https://www.hsx.vn/vi/tin-tuc/hsg-nghi-quyet-hdqt-ve-viec-thong-qua-chu-truong-thanh-lap-dia-diem-kinh-doanh-showroom-an-khanh/2417895', 'created_at': None, 'public_date': 1763055540000, 'updated_at': None, 'lang_code': 'vi', 'news_id': '11792375', 'news_short_content': 'Công ty Cổ phần Tập đoàn Hoa Sen công bố Nghị quyết HĐQT về việc thông qua chủ trương thành lập địa điểm kinh doanh Showroom An Khánh như sau:', 'news_full_content': '<p>Công ty Cổ phần Tập đoàn Hoa Sen công bố Nghị quyết HĐQT về việc thông qua chủ trương thành lập địa điểm kinh doanh Showroom An Khánh như sau:</p><table width="100%" s