group.vn/medialib/FG/2025/2025-08/2025-08-25/GIC/000000015354746_NQ_HDQT_072025_thong_qua_giao_dich_voi_GSLky.pdf" title="Tải về" download>000000015354746_NQ_HDQT_072025_thong_qua_giao_dich_voi_GSLky.pdf</a></td></tr></table>', 'price_change_pct': 0.0, 'related_ticker': 'GIC', 'fetched_at': '2026-01-04 03:53:49'}, {'id': '8238304', 'author': None, 'friendly_sub_title': '', 'news_source_link': 'https://hnx.vn/vi-vn/m-tin-tuc-hnx/tintuc-576502-1.html', 'created_at': None, 'public_date': 1755192060000, 'updated_at': None, 'lang_code': 'vi', 'news_id': '11673402', 'news_short_content': 'Báo cáo tài chính bán niên năm 2025', 'news_full_content': ' <table width="100%" style=\'text-align: left;border=0\'><tr><td colspan=\'2\'><hr /></td></tr><tr><td colspan=\'2\'>Tài liệu đính kèm</td></tr><tr><td>\xa0</td><td><a href="https://cmsv5.fiingroup.vn/medialib/FG/2025/2025-08/2025-08-14/GIC/000000015317006_VI_BaoCaoTaiChinh_Kiemtoan_Bannien_2025.pdf" title="Tải về" download>000000015317006_VI_BaoCaoTaiChinh_Kiemtoan_Bannien_2025.pdf</a></td></tr><tr><td>\xa0</td><td><a href="https://cmsv5.fiingroup.vn/medialib/FG/2025/2025-08/2025-08-14/GIC/000000015312111_EN_AuditedFinancialStatements_6month_2025.pdf" title="Tải về" download>000000015312111_EN_AuditedFinancialStatements_6month_2025.pdf</a></td></tr><tr><td>\xa0</td><td><a href="https://cmsv5.fiingroup.vn/medialib/FG/2025/2025-08/2025-08-14/GIC/000000015317007_VI_GiaiTrinhLienQuanDenBCTC_Bannien_2025.pdf" title="Tải về" download>000000015317007_VI_GiaiTrinhLienQuanDenBCTC_Bannien_2025.pdf</a></td></tr><tr><td>\xa0</td><td><a href="https://cmsv5.fiingroup.vn/medialib/FG/2025/2025-08/2025-08-14/GIC/000000015312121_EN_ExplanationsRelatingToFSs_6month_2025.pdf" title="Tải về" download>000000015312121_EN_ExplanationsRelatingToFSs_6month_2025.pdf</a></td></tr></table>', 'price_change_pct': -0.03030303, 'related_ticker': 'GIC', 'fetched_at': '2026-01-04 03:53:49'}, {'id': '8922611', 'author': None, 'friendly_sub_title': '', 'news_source_link': 'https://baodautu.vn/thuy-dien-gia-lai-nop-ho-so-niem-yet-4766-trieu-co-phieu-tren-san-hose-d450114.html', 'created_at': None, 'public_date': 1764840600000, 'updated_at': None, 'lang_code': 'vi', 'news_id': '11812172', 'news_short_content': 'Sở Giao dịch Chứng khoán TP.HCM (HoSE) đã nhận hồ sơ niêm yết hơn 47,66 triệu cổ phiếu Công ty cổ phần Thuỷ điện Gia Lai (mã GHC) trên sàn HoSE, ngày nhận hồ sơ 28/11.', 'news_full_content': '<p>Với việc tính tới ngày 3/12, cổ phiếu GHC đang giao dịch trên UPCoM vùng 28.800 đồng/cổ phiếu, tương ứng vốn hoá\xa0doanh nghiệp\xa0lên tới 1.372,68 tỷ đồng.</p>\r\n\r\n<p>Theo tìm hiểu, Thủy điện Gia Lai (tiền thân là Công ty TNHH Đầu tư và Phát triển Điện Gia Lai) được thành lập ngày 14/3/2002 với tỷ lệ góp vốn giữa Công ty Điện lực 3 và Công ty điện Gia Lai là 50:50. Ngày 26/4/2011, cổ phiếu của Công ty chính thức được giao dịch trên UPCoM với mã\xa0chứng khoán\xa0là GHC.</p>\r\n\r\n<p>Thêm nữa, theo giới thiệu trên Báo cáo thường niên năm 2024, Thuỷ điện Gia Lai đang sở hữu hai\xa0dự án\xa0thuỷ điện với công suất 28,2 MW (thuỷ điện H’Chan vận hành năm 2006, công suất 12 MW và thuỷ điện H’Mun với công suất 16,2 MW, vận hành năm 2010); 2 dự án điện gió với công 80 MW, hai dự án vận hành năm 2021; dự án điện mặt trời và điện mặt trời áp mái với tổng công suất 51,6 MWP, vận hành thương mại năm 2019.</p>\r\n\r\n<p>Thêm nữa, về cơ cấu cổ đông, tính tới ngày 30/9/2025, Thuỷ điện Gia Lai đang ghi nhận cổ đông bao gồm Công ty cổ phần Điện Gia Lai (mã GEG – sàn HoSE) sở hữu 62,53% vốn điều lệ; Tổng công ty Điện lực Miền Trung sở hữu 2,83% vốn điều lệ; và còn lại 34,63% vốn điều lệ thuộc về các cổ đông khác.</p>\r\n\r\n<p>Về tình hình kinh doanh, trong quý III/2025, Thuỷ điện Gia Lai ghi nhận doanh thu đạt 91,45 tỷ đồng, tăng 8,8% so với cùng kỳ, lợi nhuận sau thuế đạt 39,56 tỷ đồng, giảm 19% so với cùng kỳ năm trước. Trong đó, biên lợi nhuận gộp giảm từ 57,8%, về 55,6%.</p>\r\n\r\n<p>Trong kỳ, lợi nhuận gộp tăng 4,7% so với cùng kỳ, tương ứng tăng thêm 2,27 tỷ đồng, lên 50,85 tỷ đồng; doanh thu\xa0tài chính\xa0giảm 72,2%, tương ứng giảm 12,24 tỷ đồng, về 4,72 tỷ đồng; chi phí tài chính giảm 22,3%, tương ứng giảm 2,25 tỷ đồng, về 7,86 tỷ đồng; chi phí quản lý doanh nghiệp giảm 16,5%, tương ứng giảm 0,38 tỷ đồng, về 1,93 tỷ đồng và các hoạt động khác biến động không đáng kể.</p>\r\n\r\n<p>Như vậy, dù doanh thu tăng nhưng lãi ròng vẫn giảm trong quý III, nguyên nhân chủ yếu là hụt doanh thu tài chính.</p>\r\n\r\n<p>Luỹ kế trong 9 tháng đầu năm 2025, Thuỷ điện Gia Lai ghi nhận doanh thu đạt 235,72 tỷ đồng, tăng 5,3% so với cùng kỳ, lợi nhuận sau thuế đạt 123,92 tỷ đồng, tăng 9,8% so với cùng kỳ năm trước.</p>\r\n\r\n<p>Trong năm 2025, Thuỷ điện Gia Lai đặt kế hoạch tổng doanh thu 373 tỷ đồng, tương đương với cùng kỳ, lợi nhuận trước thuế dự kiến 187 tỷ đồng, giảm 9% so với thực hiện trong năm 2024.</p>\r\n\r\n<p>Như vậy, kết thúc 9 tháng đầu năm 2025 với lãi trước thuế đạt 138,3 tỷ đồng, Thuỷ điện Gia Lai đã hoàn thành 74% so với kế hoạch năm.</p>\r\n\r\n<p>Về quy mô tài sản, tính tới ngày 30/9/2025, tổng tài sản của Thuỷ điện Gia Lai tăng 4,2% so với đầu năm, tương ứng tăng thêm 62,9 tỷ đồng, lên 1.556,3 tỷ đồng. Trong đó, tài sản chủ yếu ghi nhận 706,96 tỷ đồng tài sản cố định, chiếm 45,4% tổng tài sản; 420 tỷ đồng\xa0đầu tư\xa0tài chính dài hạn, chiếm 27% tổng tài sản; 290,8 tỷ đồng các khoản phải thu ngắn hạn, chiếm 18,7% tổng tài sản và các khoản mục còn lại chiếm tỷ trọng không đáng kể.</p>\r\n\r\n<p>Thuỷ điện Gia Lai thuyết minh thêm đầu tư tài chính dài hạn bao gồm 250 tỷ đồng vào Công ty cổ phần Năng lượng VPL; và 170 tỷ đồng vào Công ty cổ phần Điện gió Ia Bang (IBE).</p>\r\n\r\n<p>Về phần nguồn vốn, tính tới ngày 30/9/2025, tổng nợ vay ngắn hạn và dài hạn của Thuỷ điện Gia Lai giảm 17,8% so với đầu năm, tương ứng giảm 69,98 tỷ đồng, về 322,55 tỷ đồng và bằng 27,9% tổng vốn chủ sở hữu. Trong đó, nợ vay ngắn hạn là 3,3 tỷ đồng và nợ vay dài hạn là 319,25 tỷ đồng.</p>\r\n\r\n<p>Về cổ phiếu, gần đây từ ngày 17/10 đến ngày 3/12, cổ phiếu GHC đã quay đầu giảm nhẹ 3,3%, từ 29.790 đồng, về 28.800 đồng/cổ phiếu.</p>', 'price_change_pct': 0.00885417, 'related_ticker': 'GHC', 'fetched_at': '2026-01-04 03:53:51'}, {'id': '8878564', 'author': None, 'friendly_sub_title': '', 'news_source_link': 'https://hnx.vn/vi-vn/m-tin-tuc-hnx/tintuc-588543-1.html', 'created_at': None, 'public_date': 1764147540000, 'updated_at': None, 'lang_code': 'vi', 'news_id': '11803725', 'news_short_content': 'Nghị quyết, Biên bản kiểm phiếu lấy ý kiến Cổ đông bằng văn bản năm 2025', 'news_full_content': '<table width="100%" style=\'text-align: left;border=0\'><tr><td colspan=\'2\'><hr /></td></tr><tr><td colspan=\'2\'>Tài liệu đính kèm</td></tr><tr><td>\xa0</td><td><a href="https://cmsv5.fiingroup.vn/medialib/FG/2025/2025-11/2025-11-26/GHC/000000015612903_GHC_NQ_DHCD_LYK_CD_bang_van_ban_nam_2025.pdf" title="Tải về" download>000000015612903_GHC_NQ_DHCD_LYK_CD_bang_van_ban_nam_2025.pdf</a></td></tr><tr><td>\xa0</td><td><a href="https://cmsv5.fiingroup.vn/medialib/FG/2025/2025-11/2025-11-26/GHC/000000015612923_GHC_Bien_ban_kiem_phieu_LYK_CD_bang_van_ban_nam_2025.pdf" title="Tải về" download>000000015612923_GHC_Bien_ban_kiem_phieu_LYK_CD_bang_van_ban_nam_2025.pdf</a></td></tr><tr><td>\xa0</td><td><a href="https://cmsv5.fiingroup.vn/medialib/FG/2025/2025-11/2025-11-26/GHC/000000015612924_GHC_Tai_lieu_lay_y_kien_co_dong_bang_van_ban_nam_2025.pdf" title="Tải về" download>000000015612924_GHC_Tai_lieu_lay_y_kien_co_dong_bang_van_ban_nam_2025.pdf</a></td></tr></table>', 'price_change_pct': 0.00031034, 'related_ticker': 'GHC', 'fetched_at': '2026-01-04 03:53:51'}, {'id': '8878561', 'author': None, 'friendly_sub_title': '', 'news_source_link': 'https://hnx.vn/vi-vn/m-tin-tuc-hnx/tintuc-588544-1.html', 'created_at': None, 'public_date': 1764147540000, 'updated_at': None, 'lang_code': 'vi', 'news_id': '11803722', 'news_short_content': 'Nghị quyết Hội đồng quản trị', 'news_full_content': '.<table width="100%" style=\'text-align: left;border=0\'><tr><td colspan=\'2\'><hr /></td></tr><tr><td colspan=\'2\'>Tài liệu đính kèm</td></tr><tr><td>\xa0</td><td><a href="https://cmsv5.fiingroup.vn/medialib/FG/2025/2025-11/2025-11-26/GHC/000000015612977_GHC_NQ_HDQT_so_23.2025_Phe_duyet_trien_khai_chuyen_san.pdf" title="Tải về" download>000000015612977_GHC_NQ_HDQT_so_23.2025_Phe_duyet_trien_khai_chuyen_san.pdf</a></td></tr></table>', 'price_change_pct': 0.00031034, 'related_ticker': 'GHC', 'fetched_at': '2026-01-04 03:53:51'}, {'id': '8795674', 'author': None, 'friendly_sub_title': '', 'news_source_link': 'https://hnx.vn/vi-vn/m-tin-tuc-hnx/tintuc-586924-1.html', 'created_at': None, 'public_date': 1762767480000, 'updated_at': None, 'lang_code': 'vi', 'news_id': '11788089', 'news_short_content': 'Tài liệu họp Đại hội đồng cổ đông', 'news_full_content': '<table width="100%" style=\'text-align: left;border=0\'><tr><td colspan=\'2\'><hr /></td></tr><tr><td colspan=\'2\'>Tài liệu đính kèm</td></tr><tr><td>\xa0</td><td><a href="https://cmsv5.fiingroup.vn/medialib/FG/2025/2025-11/2025-11-10/GHC/000000015575011_GHC_Phieu_lay_y_kien_co_dong_bang_van_ban_nam_2025.pdf" title="Tải về" download>000000015575011_GHC_Phieu_lay_y_kien_co_dong_bang_van_ban_nam_2025.pdf</a></td></tr></table>', 'price_change_pct': -0.01162162, 'related_ticker': 'GHC', 'fetched_at': '2026-01-04 03:53:51'}, {'id': '8713588', 'author': None, 'friendly_sub_title': '', 'news_source_link': 'https://hnx.vn/vi-vn/m-tin-tuc-hnx/tintuc-585425-1.html', 'created_at': None, 'public_date': 1761756240000, 'updated_at': None, 'lang_code': 'vi', 'news_id': '11777516', 'news_short_content': 'Ngày đăng ký cuối cùng lấy ý kiến cổ đông bằng văn bản', 'news_full_content': 'Thông báo ngày đăng ký cuối cùng lập danh sách cổ đông đối với cổ phiếu GHC của CTCP Thủy điện Gia Lai như sau:<br>1. Ngày đăng ký cuối cùng: 05/11/2025<br>2. Ngày giao dịch không hưởng quyền: 04/11/2025<br>3. Lý do và mục đích: <br>\xa0\xa0\xa0\xa0\xa0* Lấy ý kiến cổ đông bằng văn bản: <br>\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0- Tỷ lệ phân bổ quyền: 01 cổ phiếu - 01 quyền biểu quyết<br>\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0- Nội dung xin ý kiến: + Thông qua thực hiện phương án chuyển giao dịch cổ phiếu Công ty Cổ phần Thủy điện Gia Lai – mã chứng khoán GHC từ đăng ký giao dịch UPCOM sang niêm yết tại Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (sàn HOSE);<br>+ Các vấn đề khác (nếu có) thuộc thẩm quyền của ĐHĐCĐ phù hợp với điều lệ Tổng Công ty.<br>\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0- Thời gian thực hiện: Dự kiến từ ngày 10/11/2025 đến ngày 26/11/2025<br>\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0- Địa điểm thực hiện: Trụ sở Công ty Cổ phần Thủy điện Gia Lai, 114 Trường Chinh, Phường Pleiku, Tỉnh Gia Lai.', 'price_change_pct': 0.0142069, 'related_ticker': 'GHC', 'fetched_at': '2026-01-04 03:53:51'}, {'id': '8706012', 'author': None, 'friendly_sub_title': '', 'news_source_link': 'https://hnx.vn/vi-vn/m-tin-tuc-hnx/tintuc-585173-1.html', 'created_at': None, 'public_date': 1761650100000, 'updated_at': None, 'lang_code': 'vi', 'news_id': '11775602', 'news_short_content': 'Ngày đăng ký cuối cùng lấy ý kiến cổ đông bằng văn bản', 'news_full_content': 'Thông báo ngày đăng ký cuối cùng lập danh sách cổ đông đối với cổ phiếu GHC của CTCP Thủy điện Gia Lai như sau:<br>1. Ngày đăng ký cuối cùng: 05/11/2025<br>2. Ngày giao dịch không hưởng quyền: 04/11/2025<br>3. Lý do và mục đích: <br>\xa0\xa0\xa0\xa0\xa0* Lấy ý kiến cổ đông bằng văn bản: <br>\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0- Tỷ lệ phân bổ quyền: 01 cổ phiếu - 01 quyền biểu quyết<br>\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0- Nội dung xin ý kiến: + Thông qua thực hiện phương án chuyển giao dịch cổ phiếu Công ty Cổ phần Thủy điện Gia Lai – mã chứng khoán GHC từ đăng ký giao dịch UPCOM sang niêm yết tại Sở Giao dịch Chứng khoán Thành phố Hồ Chí Minh (sàn HOSE);<br>+ Các vấn đề khác (nếu có) thuộc thẩm quyền của ĐHĐCĐ phù hợp với điều lệ Tổng Công ty.<br>\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0- Thời gian thực hiện: Dự kiến từ ngày 10/11/2025 đến ngày 26/11/2025<br>\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0\xa0- Địa điểm thực hiện: Trụ sở Công ty Cổ phần Thủy điện Gia Lai, 114 Trường Chinh, Phường Pleiku, Tỉnh Gia Lai.', 'price_change_pct': -0.00075862, 'related_ticker': 'GHC', 'fetched_at': '2026-01-04 03:53:51'}, {'id': '8679689', 'author': None, 'friendly_sub_title': '', 'news_source_link': 'https://www.tinnhanhchungkhoan.vn/thuy-dien-gia-lai-ghc-muon-dua-co-phieu-niem-yet-tren-san-hose-post379161.html', 'created_at': None, 'public_date': 1761304320000, 'updated_at': None, 'lang_code': 'vi', 'news_id': '11762674', 'news_short_content': 'Ngày 5/11 tới đây, CTCP Thuỷ điện Gia Lai (mã GHC - UPCoM) sẽ chốt danh sách cổ đông để xin ý kiến cổ đông bằng văn bản thông qua kế hoạch niêm yết cổ phiếu GHC trên sàn HOSE.', 'news_full_content': '<div class="banner clearfix" data-platform="1" data-position="Web_AdsArticleAfterAvatar" id="adsWeb_AdsArticleAfterAvatar">Cổ phiếu GHC đăng ký giao dịch trên UPCoM từ ngày 26/04/2011 với giá chào sàn 7.300 đồng/CP. Đến nay, sau gần 15 năm giao dịch, GHC tạm đứng tại mức giá 29.100 đồng/CP trong phiên sáng 24/10, gấp gần 4 lần mức giá ban đầu.</div>\r\n\r\n<p>Thủy điện Gia Lai tiền thân là Công ty TNHH Đầu tư và Phát triển Điện Gia Lai thành lập năm 2002 và chuyển đổi thành công ty cổ phần vào năm 2008. GHC là doanh nghiệp đầu tư, xây dựng và vận hành các dự án thủy điện vừa và nhỏ, đồng thời tham gia sản xuất - kinh doanh điện năng. Công ty hiện sở hữu 2 nhà máy thủy điện với tổng công suất 28,2 MW cùng 1 nhà máy năng lượng mặt trời công suất 49 MWp, tập trung chủ yếu tại khu vực Tây Nguyên.</p>\r\n\r\n<p>Về tình hình kinh doanh của Thuỷ điện Gia Lai, trong quý III/2025, Công ty ghi nhận doanh thu đạt 91,5 tỷ đồng, tăng 9% so với cùng kỳ; nhưng lợi nhuận sau thuế giảm 19% còn chưa đến 40 tỷ đồng do nguồn thu tài chính giảm mạnh 72% còn dưới 5 tỷ đồng.</p>\r\n\r\n<p>Luỹ kế 9 tháng đầu năm, doanh thu Công ty đạt gần 236 tỷ đồng, tăng nhẹ 5% so với cùng kỳ và lãi sau thuế gần 124 tỷ đồng, tăng 10% so với cùng kỳ năm 2024. Như vậy, GHC đã thực hiện 63% mục tiêu doanh thu và 74% mục tiêu lợi nhuận năm.</p>\r\n\r\n<p>Ngày 30/10 tới đây, Thuỷ điện Gia Lai sẽ thanh toán cổ tức đợt 1/2025 cho cổ đông bằng tiền mặt, tỷ lệ 20%. Với hơn 47,6 triệu cổ phiếu đang lưu hành, dự kiến Công ty sẽ chi khoảng 95,3 tỷ đồng để tạm ứng cổ tức đợt này cho cổ đông.</p>\r\n\r\n<div class="ads_middle">\r\n<div class="banner fyi" data-position="Web_AdsArticleMiddle1" id="adsWeb_AdsArticleMiddle1">Về cơ cấu cổ đông, CTCP Điện Gia Lai (mã GEG), công ty mẹ nắm giữ 62,53% vốn GHC, qua đó sẽ nhận về hơn 59 tỷ đồng tiền cổ tức từ GHC.</div>\r\n</div>\r\n\r\n<p>Theo kế hoạch, Thủy điện Gia Lai dự kiến sẽ chia cổ tức năm 2025 trong khoảng 15 - 25%. Với việc tạm ứng ở mức 20%, Công ty có thể còn thực hiện thêm 1 đợt chi trả nữa để hoàn thành mục tiêu tối đa 25%.</p>', 'price_change_pct': -0.01327645, 'related_ticker': 'GHC', 'fetched_at': '2026-01-04 03:53:51'}, {'id': '8679679', 'author': None, 'friendly_sub_title': '', 'news_source_link': 'https://hnx.vn/vi-vn/m-tin-tuc-hnx/tintuc-584729-1.html', 'created_at': None, 'public_date': 1761240660000, 'updated_at': None, 'lang_code': 'vi', 'news_id': '11762022', 'news_short_content': 'Nghị quyết Hội đồng quản trị', 'news_full_content': '.<table width="100%" style=\'text-align: left;border=0\'><tr><td colspan=\'2\'><hr /></td></tr><tr><td colspan=\'2\'>Tài liệu đính kèm</td></tr><tr><td>\xa0</td><td><a href="https://cmsv5.fiingroup.vn/medialib/FG/2025/2025-10/2025-10-23/GHC/000000015524161_GHC_NQ_HDQT_so_21.2025.pdf" title="Tải về" download>000000015524161_GHC_NQ_HDQT_so_21.2025.pdf</a></td></tr></table>', 'price_change_pct': -0.0016041, 'related_ticker': 'GHC', 'fetched_at': '2026-01-04 03:53:51'}, {'id': '8679678', 'author': None, 'friendly_sub_title': '', 'news_source_link': 'https://hnx.vn/vi-vn/m-tin-tuc-hnx/tintuc-584730-1.html', 'created_at': None, 'public