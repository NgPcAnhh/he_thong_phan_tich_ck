Y.pdf" title="Tải về">20251224--DC4--TB2392-giao-dich-co-phieu-thay-doi-DKNY.pdf</a></td>\r\n\t\t</tr>\r\n\t</tbody>\r\n</table>', 'price_change_pct': -0.00938967, 'related_ticker': 'DC4', 'fetched_at': '2026-01-04 04:00:51'}, {'id': '8994317', 'author': None, 'friendly_sub_title': '', 'news_source_link': 'https://www.hsx.vn/vi/tin-tuc/dc4-quyet-dinh-ve-viec-thay-doi-dang-ky-niem-yet/2424340', 'created_at': None, 'public_date': 1765977420000, 'updated_at': None, 'lang_code': 'vi', 'news_id': '11822196', 'news_short_content': 'Sở Giao dịch Chứng khoán TP.HCM Quyết định về việc chấp thuận cho Công ty Cổ phần DICERA Holdings được thay đổi đăng ký niêm yết như sau:', 'news_full_content': '<p>Sở Giao dịch Chứng khoán TP.HCM Quyết định về việc chấp thuận cho Công ty Cổ phần DICERA Holdings được thay đổi đăng ký niêm yết như sau:</p>\r\n\r\n<table style="text-align: left;border=0" width="100%">\r\n\t<tbody>\r\n\t\t<tr>\r\n\t\t\t<td colspan="2">\r\n\t\t\t<hr /></td>\r\n\t\t</tr>\r\n\t\t<tr>\r\n\t\t\t<td colspan="2">Tài liệu đính kèm</td>\r\n\t\t</tr>\r\n\t\t<tr>\r\n\t\t\t<td>\xa0</td>\r\n\t\t\t<td><a download="" href="https://cmsv5.fiingroup.vn/medialib/FG/2025/2025-12/2025-12-17/DC4/20251216--DC4--QD-thay-doi-DKNY-do-phat-hanh-ESOP.pdf" title="Tải về">20251216--DC4--QD-thay-doi-DKNY-do-phat-hanh-ESOP.pdf</a></td>\r\n\t\t</tr>\r\n\t</tbody>\r\n</table>', 'price_change_pct': -0.00460829, 'related_ticker': 'DC4', 'fetched_at': '2026-01-04 04:00:51'}, {'id': '8967759', 'author': None, 'friendly_sub_title': '', 'news_source_link': 'https://www.hsx.vn/vi/tin-tuc/dc4-bao-cao-ket-qua-giao-dich-co-phieu-cua-to-chuc-co-lien-quan-den-nguoi-noi-bo-dig/2423392', 'created_at': None, 'public_date': 1765474812000, 'updated_at': None, 'lang_code': 'vi', 'news_id': '11820124', 'news_short_content': ' DIG báo cáo kết quả giao dịch cổ phiếu của tổ chức có liên quan đến người nội bộ Công ty Cổ phần DICERA Holdings như sau:', 'news_full_content': '<p>\xa0DIG báo cáo kết quả giao dịch cổ phiếu của tổ chức có liên quan đến người nội bộ Công ty Cổ phần DICERA Holdings như sau:</p><table width="100%" style=\'text-align: left;border=0\'><tr><td colspan=\'2\'><hr /></td></tr><tr><td colspan=\'2\'>Tài liệu đính kèm</td></tr><tr><td>\xa0</td><td><a href="https://cmsv5.fiingroup.vn/medialib/FG/2025/2025-12/2025-12-11/DC4/20251211--DC4--BCKQ-giao-dich-CP-cua-nguoi-co-lien-quan--DIG--CBTT.pdf" title="Tải về" download>20251211--DC4--BCKQ-giao-dich-CP-cua-nguoi-co-lien-quan--DIG--CBTT.pdf</a></td></tr></table>', 'price_change_pct': -0.01818182, 'related_ticker': 'DC4', 'fetched_at': '2026-01-04 04:00:51'}, {'id': '8961721', 'author': None, 'friendly_sub_title': '', 'news_source_link': 'https://www.tinnhanhchungkhoan.vn/dicera-holdings-dc4-giai-the-cong-ty-con-sau-6-thang-thanh-lap-post381963.html', 'created_at': None, 'public_date': 1765437480000, 'updated_at': None, 'lang_code': 'vi', 'news_id': '11819099', 'news_short_content': 'Công ty cổ phần Dicera Holdings (mã DC4 - sàn HoSE) sẽ giải thể CTCP Dicera Construction, đơn vị mà DC4 vừa cùng với CTCP Tập đoàn Đầu tư Thăng Long (mã TIG - sàn HNX) thành lập.', 'news_full_content': '<div class="banner clearfix" data-platform="1" data-position="Web_AdsArticleAfterAvatar" id="adsWeb_AdsArticleAfterAvatar">Dicera Holdings thông qua chủ trương giải thể, chấm dứt hoạt động CTCP Dicera Construction, đơn vị đang là công ty con do Dicera Holdings sở hữu 51% vốn điều lệ.</div>\r\n\r\n<p>Lý do giải thể do chủ đầu tư dự án chưa hoàn thiện xong thủ tục pháp lý để triển khai thi công.</p>\r\n\r\n<p>CTCP Dicera Construction chỉ mới thành lập ngày 10/6/2025, hoạt động trong lĩnh vực xây dựng công trình dân dụng, công nghiệp, nhà cao tầng, công trình cơ sở hạ tầng đô thị.</p>\r\n\r\n<p>Trong đó, ngày 7/6/2025, CTCP Tập đoàn Đầu tư Thăng Long (mã TIG – sàn HNX) thông qua góp vốn thành lập CTCP Dicera Construction, vốn điều lệ 100 tỷ đồng. Trong đó, TIG sẽ góp 48 tỷ đồng, chiếm 48% vốn điều lệ; DC4 sẽ góp 51 tỷ đồng, chiếm 51% vốn điều lệ và còn lại bà Trần Thị Thuý Hằng góp 1 tỷ đồng, chiếm 1% vốn điều lệ.</p>\r\n\r\n<p>Một điểm đáng lưu ý khác, Dicera Holdings vừa thông qua nhận chuyển nhượng 36,88 triệu cổ phần, tương ứng 99,68% vốn tại Công ty cổ phần Đầu tư Bất động sản Trí Holdings, giá trị chuyển nhượng là 428,6 tỷ đồng.</p>\r\n\r\n<div class="ads_middle">\r\n<div class="banner fyi" data-position="Web_AdsArticleMiddle" id="adsWeb_AdsArticleMiddle">Theo tìm hiểu, Đầu tư Bất động sản Trí Holdings là chủ đầu tư dự án chung cư Hoà Lân Thuận Giao tại Đại lộ Bình Dương, phường Thuận Giao, TP.HCM (trước là tỉnh Bình Dương), diện tích 6.138,6 m2, quy mô xây dựng cao 40 tầng với 688 căn hộ.</div>\r\n</div>\r\n\r\n<p>Thực tế, dự án đã được chấp thuận chủ trương đầu tư, đồng thời chấp thuận nhà đầu tư và có quyết định phê duyệt đồ án quy hoạch tổng mặt bằng tỷ lệ 1/500.</p>\r\n\r\n<p>Sau khi thâu tóm dự án, Dicera Holdings sẽ động thổ thi công xây dựng dự án vào tháng 12/2025.</p>\r\n\r\n<p>Được biết, tại khu vực mà dự án chung cư Hoà Lân Thuận Giao sắp được Dicera Holdings sắp mua lại, đơn vị thành viên của Kim Oanh Group đang triển khai dự án khu đô thị Hoà Lân (mặt tiền Đại lộ Bình Dương, phường Thuận Giao, TP.HCM với quy mô 50 ha, vốn đầu tư lên tới 15.000 tỷ đồng, dự án bao gồm đất nền, nhà phố, biệt thự, shophouse và căn hộ.</p>\r\n\r\n<p>Về Công ty cổ phần Đầu tư Bất động sản Trí Holdings, đơn vị được thành lập ngày 23/5/2022; địa chỉ tại thửa đất số 198, tờ bản đồ số 124, Đại lộ Bình Dương, phường Thuận Giao, TP.HCM; đại diện pháp luật là ông Trần Văn Trí; và hoạt động chính trong lĩnh vực kinh doanh bất động sản.</p>\r\n\r\n<div class="ads_middle">\r\n<div class="banner fyi" data-position="Web_AdsArticleMiddle1" id="adsWeb_AdsArticleMiddle1">Như vậy, thông qua mua cổ phần, Dicera Holdings sẽ sở hữu và sớm triển khai dự án chung cư Hoà Lân Thuận Giao với quy mô 6.138,6 m2.</div>\r\n</div>\r\n\r\n<p>Thực tế, dù quyết định bỏ ra 428,6 tỷ đồng để mua lại dự án chung cư Hoà Lân Thuận Giao nhưng tính tới ngày 30/9/2025, Dicera Holdings chỉ sở hữu 356,2 tỷ đồng tiền mặt, lượng tiền mặt đang sở hữu còn thấp hơn số tiền sắp bỏ ra để mua lại dự án.</p>\r\n\r\n<p>Xét về hoạt động kinh doanh, trong 9 tháng đầu năm 2025, Dicera Holdings ghi nhận doanh thu đạt 1.303,42 tỷ đồng, tăng 46,2% so với cùng kỳ, lợi nhuận sau thuế đạt 141,09 tỷ đồng, tăng 45,3% so với cùng kỳ. Trong đó, biên lợi nhuận gộp cải thiện từ 21,1%, lên 26,3%.</p>\r\n\r\n<p>Được biết, trong năm 2025, Dicera Holdings đặt kế hoạch tổng doanh thu 1.820 tỷ đồng, tăng 64,5% so với cùng kỳ, lợi nhuận sau thuế 172 tỷ đồng, tăng 42,8% so với thực hiện trong năm 2024 và cổ tức dự kiến với tỷ lệ từ 10% đến 15%.</p>\r\n\r\n<p>Như vậy, kết thúc 9 tháng đầu năm 2025 với lãi sau thuế đạt 141,09 tỷ đồng, Dicera Holdings đã hoàn thành 82% so với kế hoạch năm.</p>\r\n\r\n<div class="ads_middle">\r\n<div class="banner fyi" data-position="Web_AdsArticleMiddle2" id="adsWeb_AdsArticleMiddle2">Đóng cửa phiên giao dịch ngày 10/12, cổ phiếu DC4 giảm 100 đồng về 11.000 đồng/cổ phiếu.</div>\r\n</div>', 'price_change_pct': -0.01818182, 'related_ticker': 'DC4', 'fetched_at': '2026-01-04 04:00:51'}, {'id': '8955603', 'author': None, 'friendly_sub_title': '', 'news_source_link': 'https://www.hsx.vn/vi/tin-tuc/dc4-nghi-quyet-hdqt-ve-viec-thong-qua-chu-truong-giai-the-cham-dut-hoat-dong-cua-cong-ty-co-phan-dicera-construction/2423108', 'created_at': None, 'public_date': 1765384309000, 'updated_at': None, 'lang_code': 'vi', 'news_id': '11818899', 'news_short_content': 'Công ty Cổ phần DICERA Holdings công bố Nghị quyết HĐQT về việc thông qua chủ trương giải thể, chấm dứt hoạt động của Công ty Cổ phần DICERA Construction như sau:', 'news_full_content': '<p>Công ty Cổ phần DICERA Holdings công bố Nghị quyết HĐQT về việc thông qua chủ trương giải thể, chấm dứt hoạt động của Công ty Cổ phần DICERA Construction như sau:</p><table width="100%" style=\'text-align: left;border=0\'><tr><td colspan=\'2\'><hr /></td></tr><tr><td colspan=\'2\'>Tài liệu đính kèm</td></tr><tr><td>\xa0</td><td><a href="https://cmsv5.fiingroup.vn/medialib/FG/2025/2025-12/2025-12-10/DC4/20251210--DC4--NQ-HDQT-ve-chu-truong-giai-the-cham-dut-hoat-dong-cong-ty-con.pdf" title="Tải về" download>20251210--DC4--NQ-HDQT-ve-chu-truong-giai-the-cham-dut-hoat-dong-cong-ty-con.pdf</a></td></tr></table>', 'price_change_pct': -0.00900901, 'related_ticker': 'DC4', 'fetched_at': '2026-01-04 04:00:51'}, {'id': '8928666', 'author': None, 'friendly_sub_title': '', 'news_source_link': 'https://www.hsx.vn/vi/tin-tuc/dc4-thong-bao-thay-doi-nhan-su/2422170', 'created_at': None, 'public_date': 1764931469000, 'updated_at': None, 'lang_code': 'vi', 'news_id': '11813920', 'news_short_content': 'Công ty Cổ phần DICERA Holdings thông báo  thay đổi nhân sự như sau:', 'news_full_content': '<p>Công ty Cổ phần DICERA Holdings thông báo \xa0thay đổi nhân sự như sau:</p><table width="100%" style=\'text-align: left;border=0\'><tr><td colspan=\'2\'><hr /></td></tr><tr><td colspan=\'2\'>Tài liệu đính kèm</td></tr><tr><td>\xa0</td><td><a href="https://cmsv5.fiingroup.vn/medialib/FG/2025/2025-12/2025-12-05/DC4/20251204--DC4--TB-thay-doi-nhan-su--Pham-Van-Quyen.pdf" title="Tải về" download>20251204--DC4--TB-thay-doi-nhan-su--Pham-Van-Quyen.pdf</a></td></tr></table>', 'price_change_pct': -0.03043478, 'related_ticker': 'DC4', 'fetched_at': '2026-01-04 04:00:51'}, {'id': '8846187', 'author': None, 'friendly_sub_title': '', 'news_source_link': 'https://baodautu.vn/dicera-holdings-bo-ra-4286-ty-dong-de-mua-lai-du-an-chung-cu-hoa-lan-thuan-giao-d437863.html', 'created_at': None, 'public_date': 1763628960000, 'updated_at': None, 'lang_code': 'vi', 'news_id': '11797729', 'news_short_content': 'Công ty cổ phần Dicera Holdings (mã DC4 – sàn HoSE) lên kế hoạch mua lại dự án chung cư Hoà Lân Thuận Giao với quy mô 6.138,6 m2 tại Đại lộ Bình Dương, phường Thuận Giao, TP.HCM.', 'news_full_content': '<p>Dicera Holdings thông qua nhận chuyển nhượng 36,88 triệu cổ phần, tương ứng 99,68% vốn tại Công ty cổ phần Đầu tư\xa0Bất động sản\xa0Trí Holdings, giá trị chuyển nhượng là 428,6 tỷ đồng.</p>\r\n\r\n<p>Theo tìm hiểu, Đầu tư Bất động sản Trí Holdings là chủ\xa0đầu tư\xa0dự án\xa0chung cư Hoà Lân Thuận Giao tại Đại lộ Bình Dương, phường Thuận Giao, TP.HCM (trước là tỉnh Bình Dương), diện tích 6.138,6 m2, quy mô xây dựng cao 40 tầng với 688 căn hộ.</p>\r\n\r\n<p>Thực tế, dự án đã được chấp thuận chủ trương đầu tư, đồng thời chấp thuận nhà đầu tư và có quyết định phê duyệt đồ án quy hoạch tổng mặt bằng tỷ lệ 1/500.</p>\r\n\r\n<p>Sau khi thâu tóm, Dicera Holdings sẽ động thổ thi công xây dựng dự án vào tháng 12/2025.</p>\r\n\r\n<p>Được biết, tại khu vực mà dự án chung cư Hoà Lân Thuận Giao sắp được Dicera Holdings sắp mua lại, đơn vị thành viên của Kim Oanh Group đang triển khai dự án khu đô thị Hoà Lân (mặt tiền Đại lộ Bình Dương, phường Thuận Giao, TP.HCM với quy mô 50 ha, vốn đầu tư lên tới 15.000 tỷ đồng, dự án bao gồm đất nền, nhà phố, biệt thự, shophouse và căn hộ.</p>\r\n\r\n<p>Về Công ty cổ phần Đầu tư Bất động sản Trí Holdings, đơn vị được thành lập ngày 23/5/2022; địa chỉ tại thửa đất số 198, tờ bản đồ số 124, Đại lộ Bình Dương, phường Thuận Giao, TP.HCM; đại diện pháp luật là ông Trần Văn Trí; và hoạt động chính trong lĩnh vực kinh doanh bất động sản.</p>\r\n\r\n<p>Như vậy, thông qua mua cổ phần, Dicera Holdings sẽ sở hữu và sớm triển khai dự án chung cư Hoà Lân Thuận Giao với quy mô 6.138,6 m2.</p>\r\n\r\n<p>Thực tế, dù quyết định bỏ ra 428,6 tỷ đồng để mua lại dự án chung cư Hoà Lân Thuận Giao nhưng tính tới ngày 30/9/2025, Dicera Holdings chỉ sở hữu 356,2 tỷ đồng tiền mặt, lượng tiền mặt đang sở hữu còn thấp hơn số tiền sắp bỏ ra để mua lại dự án.</p>\r\n\r\n<p>Trái với hoạt động đi thâu tóm dự án, gần đây cổ đông lớn lại có động thái thoái vốn tại Dicera Holdings.</p>\r\n\r\n<p>Tổng CTCP Đầu tư Phát triển Xây dựng (DIC Corp, mã DIG – sàn HoSE) đăng ký bán 2,3 triệu cổ phiếu Công ty cổ phần Dicera Holdings – tên trước đây là Công ty cổ phần Xây dựng DIC Holdings - để giảm sở hữu từ 28,39%, về 25,97% vốn điều lệ, giao dịch dự kiến thực hiện từ ngày 6/11 đến ngày 5/12.</p>\r\n\r\n<p>Thêm nữa, tính tới ngày 30/9/2025, DIC Corp đang sở hữu 28,39% vốn điều lệ tại Dicera Holdings (tương ứng 27.047.032 cổ phiếu), tương ứng giá trị 221,41 tỷ đồng. Như vậy giá cổ phiếu mà DIC Corp đang đầu tư trung bình khoảng 8.186 đồng/cổ phiếu.</p>\r\n\r\n<p>Trước đó, DIC Corp thông qua chủ trương bán một phần sở hữu tại Dicera Holdings, thời gian dự kiến trong quý IV/2025. Trong đó, Công ty sẽ uỷ quyền cho Chủ tịch HĐQT và/hoặc Tổng giám đốc quyết định số lượng và giá bán cổ phần từng thời điểm cụ thể phù hợp với tình hình thị trường và nhu cầu vốn.</p>\r\n\r\n<p>Điểm đáng lưu ý, sau giao dịch, Dicera Holdings vẫn là công ty liên kết của DIC Corp.</p>\r\n\r\n<p>Thực tế, trước thời điểm mà Dicera Holdings chuyển sàn sang HoSE năm 2020, DIC Corp sở hữu tới 40,65% vốn điều lệ tại Dicera Holdings. Tuy nhiên, sau đó tỷ lệ sở hữu của DIC Corp tại Dicera Holdings liên tục suy giảm theo thời gian.</p>\r\n\r\n<p>Trong nửa đầu năm 2025, DIC Corp đã giảm sở hữu từ 35,89%, về 28,39% vốn điều lệ tại Dicera Holdings.</p>\r\n\r\n<p>Xét về hoạt động kinh doanh, trong 9 tháng đầu năm 2025, Dicera Holdings ghi nhận doanh thu đạt 1.303,42 tỷ đồng, tăng 46,2% so với cùng kỳ, lợi nhuận sau thuế đạt 141,09 tỷ đồng, tăng 45,3% so với cùng kỳ. Trong đó, biên lợi nhuận gộp cải thiện từ 21,1%, lên 26,3%.</p>\r\n\r\n<p>Được biết, trong năm 2025, Dicera Holdings đặt kế hoạch tổng doanh thu 1.820 tỷ đồng, tăng 64,5% so với cùng kỳ, lợi nhuận sau thuế 172 tỷ đồng, tăng 42,8% so với thực hiện trong năm 2024 và cổ tức dự kiến với tỷ lệ từ 10% đến 15%.</p>\r\n\r\n<p>Như vậy, kết thúc 9 tháng đầu năm 2025 với lãi sau thuế đạt 141,09 tỷ đồng, Dicera Holdings đã hoàn thành 82% so với kế hoạch năm.</p>\r\n\r\n<p>Về cổ phiếu, từ ngày 8/7 đến ngày 19/11, cổ phiếu DC4 quay đầu giảm tới 19,7%, từ 14.750 đồng về 11.850 đồng/cổ phiếu và đang giao dịch dưới đường MA 200.</p>', 'price_change_pct': 0.0, 'related_ticker': 'DC4', 'fetched_at': '2026-01-04 04:00:51'}, {'id': '9032709', 'author': None, 'friendly_sub_title': '', 'news_source_link': 'https://hnx.vn/vi-vn/m-tin-tuc-hnx/tintuc-591145-1.html', 'created_at': None, 'public_date': 1766574720000, 'updated_at': None, 'lang_code': 'vi', 'news_id': '11825613', 'news_short_content': 'Phạm Đức Dũng - Chủ tịch HĐQT - đăng ký mua 50.000 CP', 'news_full_content': '- Tên cá nhân thực hiện giao dịch: Phạm Đức Dũng <br>- Chức vụ hiện nay tại TCNY: Chủ tịch HĐQT<br>- Mã chứng khoán: DC2<br>- Số lượng cổ phiếu nắm giữ trước khi thực hiện giao dịch: 782.220 CP (tỷ lệ 6,92%) <br>- Số lượng cổ phiếu đăng ký mua: 50.000 CP <br>- Mục đích thực hiện giao dịch: Tăng tỉ lệ sở hữu <br>- Phương thức giao dịch: Thỏa thuận và khớp lệnh<br>- Ngày dự kiến bắt đầu giao dịch: 25/12/2025<br>- Ngày dự kiến kết thúc giao dịch: 22/01/2026.', 'price_change_pct': 0.0, 'related_ticker': 'DC2', 'fetched_at': '2026-01-04 04:00:54'}, {'id': '8988565', 'author': None, 'friendly_sub_title': '', 'news_source_link': 'https://hnx.vn/vi-vn/m-tin-tuc-hnx/tintuc-590420-1.html', 'created_at': None, 'public_date': 1765905780000, 'updated_at': None, 'lang_code': 'vi', 'news_id': '11821871', 'news_short_content': 'Nghị quyết Hội đồng quản trị', 'news_full_content': '.<table width="100%" style=\'text-align: left;border=0\'><tr><td colspan=\'2\'><hr /></td></tr><tr><td colspan=\'2\'>Tài liệu đính kèm</td></tr><tr><td>\xa0</td><td><a href="https://cmsv5.fiingroup.vn/medialib/FG/2025/2025-12/2025-12-16/DC2/000000015657672_NQ11_PGBANK_TAI_CAP_VON_20252026_signed.pdf" title="Tải về" download>000000015657672_NQ11_PGBANK_TAI_CAP_VON_20252026_signed.pdf</a></td></tr></table>', 'price_change_pct': -0.0625, 'related_ticker': 'DC2', 'fetched_at': '2026-01-04 04:00:54'}, {'id': '8867713', 'author': None, 'friendly_sub_title': '', 'news_source_link': 'https://hnx.vn/vi-vn/m-tin-tuc-hnx/tintuc-588310-1.html', 'created_at': None, 'publ